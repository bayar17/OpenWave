# Merge into the working x86_64 OpenWave reference configuration.
# Built-ins avoid requiring a separate target module installation.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CHECKPOINT_RESTORE=y
# The pinned Android 17 images are zygote64_32 builds: init runs the 32-bit
# /vendor/bin/boringssl_self_test32 at early-init with reboot_on_failure.
# Without 32-bit ELF support execv fails (ENOEXEC) and Android shuts down
# seconds after LXC reports RUNNING. 32-bit bionic also needs the legacy
# 32-bit time syscalls.
CONFIG_IA32_EMULATION=y
CONFIG_COMPAT_32BIT_TIME=y
# Android's prng_seeder reads /dev/hw_random and hangs forever on ENODEV.
# QEMU guests have no hardware RNG unless virtio-rng is built and attached.
CONFIG_HW_RANDOM_VIRTIO=y
# Android's own kernel requirements (AOSP android-base.config), distinct
# from what the host-side waydroid-net.sh needs above. Observed without
# them: NetBpfLoad "Kernel eBPF JIT failure ... ret=-95" and netd exiting
# with status 3 in a loop, which kills zygote on every iteration, so
# system_server never starts. SECMARK/CONNSECMARK targets are intentionally
# omitted: they would feed host SELinux packet checks.
CONFIG_BPF_JIT=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_XFRM_USER=y
CONFIG_TUN=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
# Android's platform BPF programs attach to tracepoints. With FTRACE off the
# loader reports "Error when loading /system/etc/bpf/gpuMem.bpf: Invalid
# argument", the gpu_mem map is never pinned, and system_server aborts in
# libmeminfo ReadProcessGpuUsageKb -> BpfMapRO::abortOnMismatch about five
# minutes into first boot, restarting zygote in a loop.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_TRACE_GPU_MEM=y
# Android's /data lives on the host ext4 filesystem. vold sets a POSIX default
# ACL on /data/media/<user>; without ACL support it logs "Failed to set
# default ACL on /data/media/0: Operation not supported", user storage
# preparation fails, Android tries to reboot into recovery to wipe data, and
# system_server's android.fg thread hangs there until the Watchdog kills it.
CONFIG_EXT4_FS_POSIX_ACL=y
# lmkd uses pressure-stall information to manage Android memory.
CONFIG_PSI=y
# Retain the host security boundary.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Stage 8: Android allocates media (codec) buffers from the DMA-BUF system
# heap; waydroid-init warns "DMA-BUF system heap does not exist" without it.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# Stage 8: Android's early init (waydroid-preinit) protects /proc/sysrq-trigger
# and stops its /proc setup when the file is missing, which leaves
# /proc/sys/net read-only and Android unable to configure its network.
# The file must exist; the keyboard SysRq combinations stay disabled.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
