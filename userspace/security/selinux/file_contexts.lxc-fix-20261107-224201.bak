/var/lib/iwd(/.*)? system_u:object_r:openwave_iwd_state_t:s0
/dev/tty[0-9]+ system_u:object_r:openwave_console_t:s0
/Data/Users/[^/]+/\.DataLocation(/Applications)? -d system_u:object_r:openwave_app_storage_t:s0
/run/openwave/apps -d system_u:object_r:openwave_app_storage_t:s0
/etc/selinux/openwave/contexts(/.*)? system_u:object_r:openwave_label_config_t:s0

/dev/tty system_u:object_r:openwave_console_t:s0
/dev/loop-control system_u:object_r:openwave_loop_control_t:s0
