/System(/.*)? system_u:object_r:openwave_runtime_t:s0
/Applications(/.*)? system_u:object_r:openwave_user_bundle_t:s0
/Applications/[^/]+/bin(/.*)? system_u:object_r:openwave_user_app_exec_t:s0
/System/Applications/[^/]+/bin(/.*)? system_u:object_r:openwave_app_exec_t:s0
/Data(/.*)? system_u:object_r:openwave_user_data_t:s0
/Data/Users/[^/]+/\.DataLocation/Applications/[^/]+(/.*)? system_u:object_r:openwave_app_data_t:s0
/var(/.*)? system_u:object_r:openwave_private_t:s0
/var/openwave(/.*)? system_u:object_r:openwave_wallpaper_state_t:s0
/var/cache/fontconfig(/.*)? system_u:object_r:openwave_runtime_t:s0
/dev(/.*)? system_u:object_r:openwave_device_t:s0
/dev/(null|zero|random|urandom) system_u:object_r:openwave_null_t:s0
/dev/console system_u:object_r:openwave_console_t:s0
/dev/dri(/.*)? system_u:object_r:openwave_gpu_t:s0
/dev/shm(/.*)? system_u:object_r:openwave_app_data_t:s0

/sbin/openrc-init -- system_u:object_r:openwave_openrc_exec_t:s0

# Writable supervisor and persistent service state, never executable runtime.
/(run|tmp)(/.*)? system_u:object_r:openwave_run_t:s0
/var/(lib|log|cache)(/.*)? system_u:object_r:openwave_state_t:s0
/run/user/1000/openwave-logs(/.*)? system_u:object_r:openwave_qa_evidence_t:s0
/run/udev(/.*)? system_u:object_r:openwave_udev_runtime_t:s0
/run/dbus(/.*)? system_u:object_r:openwave_dbus_runtime_t:s0
/run/user/1000/bus -s system_u:object_r:openwave_dbus_runtime_t:s0
/run/openrc(/.*)? system_u:object_r:openwave_openrc_state_t:s0
/run/openrc/init\.ctl -p system_u:object_r:openwave_power_fifo_t:s0
# Canonical runtime links are readable without granting access to /var state.
/var/(run|lock) -l system_u:object_r:openwave_run_t:s0
/var/lib/openwave/app-identities(/.*)? system_u:object_r:openwave_appd_state_t:s0
/var/lib/openwave/permissions(/.*)? system_u:object_r:openwave_permission_state_t:s0
