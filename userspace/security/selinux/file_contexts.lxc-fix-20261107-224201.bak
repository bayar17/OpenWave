/var/lib/openwave-accounts(/.*)? system_u:object_r:openwave_accounts_t:s0
/run/openwave/public-preferences\.ini(\..*)? system_u:object_r:openwave_public_preferences_t:s0
/dev/input(/.*)? system_u:object_r:openwave_input_t:s0
/dev/rfkill -c system_u:object_r:openwave_rfkill_t:s0
/(usr/)?lib/firmware(/.*)? system_u:object_r:openwave_firmware_t:s0
/run/NetworkManager(/.*)? system_u:object_r:openwave_networkmanager_state_t:s0
/run/NetworkManager/resolv\.conf(\.tmp)? -- system_u:object_r:openwave_dns_config_t:s0
