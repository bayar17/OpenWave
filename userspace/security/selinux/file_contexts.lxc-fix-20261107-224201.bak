/var/lib/waydroid-user(/.*)? system_u:object_r:openwave_waydroid_user_t:s0
/var/lib/misc system_u:object_r:openwave_misc_t:s0
/var/lib/misc/dnsmasq\.waydroid0\.leases(\.new)? system_u:object_r:openwave_waydroid_lease_t:s0
/run/waydroid-lxc(/.*)? system_u:object_r:openwave_waydroid_net_runtime_t:s0
/run/xtables\.lock system_u:object_r:openwave_xtables_lock_t:s0
/usr/lib/waydroid/data/scripts/waydroid-net\.sh system_u:object_r:openwave_waydroid_net_exec_t:s0
/run/waydroid(/.*)? system_u:object_r:openwave_waydroid_runtime_t:s0

/run/openwave(/.*)? system_u:object_r:openwave_service_run_t:s0
/run/openwave/waydroid(/.*)? system_u:object_r:openwave_waydroid_snapshot_t:s0
/run/openwave/apps/[^/]+(/.*)? system_u:object_r:openwave_app_data_t:s0
