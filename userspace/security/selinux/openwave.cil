(allow openwave_appd_t openwave_app_data_t (file (read write append open getattr create setattr unlink rename link lock map)))
(allow openwave_appd_t openwave_app_data_t (lnk_file (read getattr create setattr unlink rename)))
(allow openwave_app_t openwave_app_storage_t (dir (search getattr)))
