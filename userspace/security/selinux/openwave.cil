;; OPENWAVE_LXC_DOMAIN_STAGE_BEGIN
(type openwave_lxc_t)
(type openwave_lxc_start_exec_t)
(roletype system_r openwave_lxc_t)

;; Authorization for LXC process transition (enabled in activation step).
(allow openwave_waydroid_manager_t openwave_lxc_start_exec_t
       (file (read open getattr execute)))
(allow openwave_waydroid_manager_t openwave_lxc_t (process (transition)))
(allow openwave_lxc_t openwave_lxc_start_exec_t
       (file (entrypoint read open getattr execute map)))

;; Stage 2Q: once /run traversal succeeds, LXC requests an anonymous
;; memfd for its own process and enforcing SELinux denies { create } on
;; openwave_lxc_t:self memfd_file. Grant precisely the observed creation
;; operation. No memfd execute/map/write/read, process execmem, file exec,
;; or LSM policy authority is conferred; future operations require their
;; own evidence and separate review.
(allow openwave_lxc_t self (memfd_file (create)))

;; LXC server's abstract Unix command socket.
(allow openwave_lxc_t self
       (unix_stream_socket (create bind listen accept read write connectto)))
(allow openwave_waydroid_manager_t openwave_lxc_t
       (unix_stream_socket (connectto)))
;; Existing OpenWave QA/system lifecycle clients need the same audited access.
(allow openwave_system_t openwave_lxc_t
       (unix_stream_socket (connectto)))

;; LXC metadata and runtime area (not a general /run authorization).
(allow openwave_lxc_t openwave_lxc_run_t
       (dir (search read open getattr write add_name remove_name create)))
(allow openwave_lxc_t openwave_lxc_run_t
       (file (read open getattr write create unlink lock setattr)))

;; Waydroid's LXC state/configuration area (audit further rights before release).
;; Stage 2O: lxc-start reaches its own initialization and attempts to
;; create a .cache directory inside Waydroid's already-confined state
;; subtree. The parent already allows write/add_name/remove_name, but the
;; child directory lacked create. Grant create to this one state type only.
;; This is type-wide, not limited to the basename .cache.
(allow openwave_lxc_t openwave_waydroid_state_t
       (dir (search read open getattr write add_name remove_name create)))
(allow openwave_lxc_t openwave_waydroid_state_t
       (file (read open getattr write create setattr lock unlink)))
(allow openwave_lxc_t openwave_waydroid_state_t
       (sock_file (create read write getattr unlink)))

;; LXC's known namespace and cgroup discovery reads.
(allow openwave_lxc_t openwave_namespace_t (file (getattr read open)))
(allow openwave_lxc_t openwave_cgroup_t (filesystem (getattr)))
(allow openwave_lxc_t openwave_cgroup_t (dir (search read open getattr)))

;; Diagnostic only: /proc/<pid>/cgroup commonly carries process domain type.
;; Narrow these after runtime inspection instead of making them production defaults.
(allow openwave_lxc_t openwave_system_t (dir (search)))
(allow openwave_lxc_t openwave_system_t (file (read open getattr)))
;; Stage 2K: lxc-start must traverse the host's root directory before it
;; resolves its already-confined Waydroid state, runtime, and ELF paths.
;; EROFS/vendor mount success does not imply this search permission. Grant
;; search ONLY: no listing, opening, reading, mutation, mounton, or file reads
;; on the generic openwave_default_t objects.
(allow openwave_lxc_t openwave_default_t (dir (search)))
;; OPENWAVE_LXC_DOMAIN_STAGE_END

;; OPENWAVE_LXC_DOMAIN_ACTIVATE_BEGIN
;; Transition only lxc-start invoked from Waydroid manager.
;; lxc-info, lxc-stop, etc retain their existing execution behavior.
(typetransition openwave_waydroid_manager_t openwave_lxc_start_exec_t
                process openwave_lxc_t)
;; OPENWAVE_LXC_DOMAIN_ACTIVATE_END

;; OPENWAVE_LXC_TRANSITION_IO_86

;; Inherited Waydroid pipes and system descriptors.
(allow openwave_lxc_t openwave_waydroid_manager_t
       (fd (use)))

(allow openwave_lxc_t openwave_system_t
       (fd (use)))

;; Waydroid-managed stdout/stderr pipes.
(allow openwave_lxc_t openwave_waydroid_manager_t
       (fifo_file (read write getattr)))

;; Null device used during descriptor sanitization.
(allow openwave_lxc_t openwave_null_t
       (chr_file (open read write getattr)))

;; Preserve normal process execution characteristics.
(allow openwave_waydroid_manager_t openwave_lxc_t
       (process (rlimitinh siginh)))

;; Allow LXC to notify its parent on termination.
(allow openwave_lxc_t openwave_waydroid_manager_t
       (process (sigchld)))

;; Diagnostic 87: LXC ELF loader access
;; Stage 2L: the prior stage granted host root traversal only. Dynamic
;; linking lxc-start still needs pathname search in /etc, /lib64 and /usr,
;; all labeled openwave_runtime_t. Read-only shared object mapping was
;; already granted via the dedicated dynamic-linker client attribute.
;; This is directory metadata/traversal only: no listing/open/write/mounton.
(allow openwave_lxc_t openwave_runtime_t (dir (search getattr)))

;; Stage 2M: after the shared-library loader succeeds, LXC checks its
;; configuration root (/var/lib/waydroid/lxc) and probes procfs/sysfs.
;; /var is openwave_private_t, while /proc and /sys roots use their
;; dedicated pseudo-filesystem types. Path traversal only: no directory
;; enumeration, file reads, device access, re-labels, or mount authority.
;; These are type-scoped permissions, not one-path permissions: all
;; directories carrying these types permit search. Reassess labels as
;; the host path taxonomy is refined.
(allow openwave_lxc_t openwave_private_t (dir (search)))
(allow openwave_lxc_t openwave_proc_t (dir (search)))
(allow openwave_lxc_t openwave_sysfs_t (dir (search)))

;; Stage 2O: LXC made metadata-only queries of /run (tmpfs root)
;; and selinuxfs. These do not permit directory enumeration, file
;; reads or policy administration. Procfs file/symlink read denials
;; remain deferred until narrower proc object labeling is audited.
;; Stage 2P: LXC's next observed AVC is dir {search} on the
;; tmpfs /run root labeled openwave_run_t, after Stage 2O granted only
;; getattr. Permit pathname traversal without listing, opening,
;; changing, mounting on or accessing files in other /run subtrees.
;; SELinux type-scoped: all openwave_run_t dirs gain search/getattr.
(allow openwave_lxc_t openwave_run_t (dir (search getattr)))
(allow openwave_lxc_t openwave_security_t (filesystem (getattr)))

;; Stage 2N: /var/lib itself has the generic state-directory label,
;; openwave_state_t, distinct from /var (private_t) and the Waydroid
;; subtrees (waydroid_state_t). The actual enforcing AVC denies ONLY
;; search on name="lib" under /var and stops lxc-start before config load.
;; Permit pathname traversal through state-labeled parent directories.
;; This is type-wide search, not permission to enumerate or read them.
(allow openwave_lxc_t openwave_state_t (dir (search)))
(allow openwave_lxc_t
       openwave_runtime_t
       (file (open read getattr map)))

; WAYDROID_MOUNT_OBSERVER_STAGE2I_BEGIN
; The opt-in read-only preflight runs under the OpenRC system domain.
; Permit inspection of *only* the fixed helper's inode/ELF/SELinux label
; and the dedicated loop-control node's metadata. Not execute, ioctl,
; open device, mount, process transition, or sys_admin authorization.
(allow openwave_system_t openwave_waydroid_mount_exec_t
       (file (getattr read open)))
(allow openwave_system_t openwave_loop_control_t
       (chr_file (getattr)))
; WAYDROID_MOUNT_OBSERVER_STAGE2I_END

; WAYDROID_MOUNT_BOUNDARY_STAGE2A_BEGIN
; The fixed-operation executable is not yet invoked by upstream Waydroid.
; Manager -> helper transition is staged, but filesystem privileges are denied.
(typetransition openwave_waydroid_manager_t openwave_waydroid_mount_exec_t
                process openwave_waydroid_mount_t)
(allow openwave_waydroid_manager_t openwave_waydroid_mount_exec_t
       (file (read open getattr map execute)))
(allow openwave_waydroid_manager_t openwave_waydroid_mount_t
       (process (transition sigchld signull getattr rlimitinh siginh noatsecure)))
(allow openwave_waydroid_mount_t openwave_waydroid_mount_exec_t
       (file (entrypoint read open getattr map execute)))
(allow openwave_waydroid_mount_t openwave_waydroid_manager_t (fd (use)))
(allow openwave_waydroid_mount_t openwave_waydroid_manager_t (process (sigchld)))
(allow openwave_waydroid_mount_t self (process (getattr getcap getrlimit)))
(allow openwave_waydroid_mount_t openwave_default_t (dir (search getattr)))
(allow openwave_waydroid_mount_t openwave_runtime_t (dir (search getattr)))
; Preinstalled Android image files live under /usr/share/waydroid-extra.
(allow openwave_waydroid_mount_t openwave_runtime_t (file (read open getattr)))
(allow openwave_waydroid_mount_t openwave_waydroid_state_t
       (dir (search getattr read open)))
(allow openwave_waydroid_mount_t openwave_waydroid_state_t
       (file (read open getattr)))
(allow openwave_waydroid_mount_t openwave_proc_t (dir (search getattr)))
(allow openwave_waydroid_mount_t openwave_proc_t (file (read open getattr)))
(allow openwave_waydroid_mount_t openwave_security_t (file (read open getattr)))
; The helper checks the enforcement state but may not change it.
(allow openwave_waydroid_mount_t openwave_selinux_enforce_t
       (file (read open getattr)))
; The new entrypoint is not executable by ordinary native applications.
(neverallow openwave_app_t openwave_waydroid_mount_exec_t
            (file (execute execute_no_trans entrypoint)))
; Do not grant these until the image, mountpoint and namespace checks prove
; that the helper can safely perform the exact requested operations.
(neverallow openwave_waydroid_mount_t self
            (capability (sys_admin sys_boot sys_time net_admin net_raw)))
(neverallow openwave_waydroid_mount_t openwave_all_types
            (security (load_policy setenforce)))
(neverallow openwave_waydroid_mount_t openwave_default_t
            (filesystem (mount remount unmount)))
; WAYDROID_MOUNT_BOUNDARY_STAGE2A_END
