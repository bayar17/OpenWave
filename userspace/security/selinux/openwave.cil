; Executables that remain openwave_runtime_t still require this during the
; staged label migration. The ELF interpreter now gets a separate inode type.
; Do not remove this legacy execute rule before auditing every actual exec path.
(allow openwave_system_t openwave_runtime_t
    (file (read open getattr map execute execute_no_trans)))

; Only executable-loader clients may map the host's read-only ELF interpreter
; and trusted shared objects. Unlike the broad native-service attribute, this
; new attribute conveys ONLY dynamic-linker file access; Waydroid/LXC do not
; inherit runtime/container privileges through it.
(typeattribute openwave_dynamic_link_client)
(typeattributeset openwave_dynamic_link_client
    (openwave_system_t openwave_app_t openwave_native_service
     openwave_waydroid_manager_t openwave_waydroid_launcher_t
     openwave_waydroid_helper_t openwave_waydroid_net_t openwave_lxc_t
     openwave_waydroid_mount_t))
(allow openwave_dynamic_link_client openwave_elf_loader_t
    (file (read open getattr map execute execute_no_trans)))
(allow openwave_dynamic_link_client openwave_elf_loader_t
    (lnk_file (read getattr)))
(allow openwave_dynamic_link_client openwave_shared_lib_t
    (file (read open getattr map execute)))
(allow openwave_dynamic_link_client openwave_shared_lib_t
    (lnk_file (read getattr)))

; Runtime mapping never authorizes changing trusted executable bytes. The
; system supervisor remains responsible for trusted installation/relabeling.
(typeattribute openwave_untrusted_link_client)
(typeattributeset openwave_untrusted_link_client
    (openwave_app_t openwave_native_service
     openwave_waydroid_manager_t openwave_waydroid_launcher_t
     openwave_waydroid_helper_t openwave_waydroid_net_t openwave_lxc_t
     openwave_waydroid_mount_t))
(neverallow openwave_untrusted_link_client openwave_elf_loader_t
    (file (write append create setattr unlink link rename relabelfrom relabelto)))
(neverallow openwave_untrusted_link_client openwave_shared_lib_t
    (file (write append create setattr unlink link rename relabelfrom relabelto)))
; Shared objects may be mapped executable but must not become direct
; process entrypoints or an execve-without-transition bypass.
(neverallow openwave_untrusted_link_client openwave_shared_lib_t
    (file (entrypoint execute_no_trans)))
(neverallow openwave_untrusted_link_client openwave_elf_loader_t
    (file (entrypoint)))

; PID 1 and its child processes need these base permissions after enforcement.
; Grant them only to the trusted system domain, not application domains.
(allow openwave_system_t self (process (fork)))
(allow openwave_system_t openwave_proc_t (dir (search getattr)))

; The PID 1/OpenRC domain must traverse sysfs and selinuxfs.
; Keep SELinux enforcement file access isolated from policy load and other
; SELinux control files; do not grant setenforce to the shared system domain.
(allow openwave_system_t openwave_sysfs_t (dir (search getattr)))
(allow openwave_system_t openwave_security_t (dir (search getattr)))
(allow openwave_system_t openwave_selinux_enforce_t (file (open read write getattr)))

; The bootstrap's console is relabeled to openwave_console_t before enforcing.
(allow openwave_system_t openwave_console_t (chr_file (open read write getattr ioctl)))

; OpenRC manages the dedicated QA evidence directory.
; The named directory receives its evidence type at creation.

(allow openwave_system_t openwave_runtime_t (dir (search getattr)))

(typetransition openwave_system_t openwave_run_t dir "openwave-logs" openwave_qa_evidence_t)

; Allow the system supervisor to manage QA evidence.

(allow openwave_system_t openwave_private_t (dir (search)))

(allow openwave_system_t openwave_qa_evidence_t (dir (add_name create getattr open read remove_name search setattr write)))

(allow openwave_system_t openwave_qa_evidence_t (file (append create getattr open read rename setattr unlink write)))

; Application services can write to dedicated QA evidence,
; not to unrelated private or runtime files.

(allow openwave_appd_t openwave_qa_evidence_t (file (append getattr open write)))

(allow openwave_wallpaper_t openwave_qa_evidence_t (file (append getattr open write)))

(allow openwave_shell_t openwave_qa_evidence_t (file (append getattr open write)))

; Permit use of log file descriptors inherited from OpenRC.

(allow openwave_appd_t openwave_system_t (fd (use)))

(allow openwave_wallpaper_t openwave_system_t (fd (use)))

(allow openwave_shell_t openwave_system_t (fd (use)))


