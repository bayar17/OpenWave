(allow openwave_shell_t openwave_input_t (dir (search read open getattr)))
(allow openwave_shell_t openwave_input_t (chr_file (read write open getattr ioctl)))
(allow openwave_shell_t openwave_console_t (chr_file (map)))
(allow openwave_udev_t openwave_input_t (dir (search read open getattr write create add_name remove_name setattr)))
(allow openwave_udev_t openwave_input_t (chr_file (read write open getattr ioctl setattr)))
(allow openwave_udev_t openwave_input_t (lnk_file (read getattr create unlink setattr)))
(allow openwave_system_t openwave_input_t (dir (search read open getattr ioctl)))
(allow openwave_system_t openwave_input_t (chr_file (read open getattr ioctl)))
(neverallow openwave_app_t openwave_input_t (chr_file (all)))
; Compositor access to buffers explicitly received over the client connection.
(allow openwave_shell_t openwave_app_t (fd (use)))
(allow openwave_shell_t openwave_app_t (memfd_file (read write getattr map)))
(allow openwave_shell_t openwave_app_data_t (file (read open getattr map)))

; Broker identity checks use read-only proc metadata, never process tracing.
; Service exec paths cannot return to the privileged supervisor domain.
(neverallow openwave_native_service openwave_all_types (process (ptrace dyntransition)))
(neverallow openwave_native_service openwave_system_t (process (transition)))

; appd is the privileged namespace/account launcher. These capabilities cover
; credential changes, owned socket publication, and Bubblewrap/setns/chroot;
; the final application domain retains its all-capabilities neverallow.
(allow openwave_appd_t self (capability (chown fowner dac_override setgid setuid setpcap kill sys_admin sys_chroot)))
(allow openwave_appd_t self (process (setcap)))
(allow openwave_appd_t self (process (sigkill sigstop)))
(allow openwave_appd_t openwave_gpu_t (dir (search read open getattr)))
(allow openwave_appd_t openwave_gpu_t (chr_file (getattr)))
; Public aliases retain the original socket inode/label. appd validates the
; configured session owner before publishing Wayland and session-bus links.
(allow openwave_appd_t openwave_run_t (sock_file (getattr setattr link rename unlink)))
(allow openwave_appd_t openwave_dbus_runtime_t (sock_file (getattr setattr link rename unlink)))
;; Stage 2H: appd sends bounded activate/quit requests to the per-process
;; ApplicationChannel socket. It authenticates SO_PEERCRED UID and exact PID;
;; the application accepts only authenticated local peers. This grants no
;; application-to-broker socket authority or wildcard target domain access.
(allow openwave_appd_t openwave_app_t (unix_stream_socket (connectto)))
(allow openwave_appd_t openwave_app_t (process (getattr signal signull sigkill getpgid)))
(allow openwave_appd_t openwave_app_t (dir (search read open getattr)))
(allow openwave_appd_t openwave_app_t (file (read open getattr)))
(allow openwave_appd_t openwave_app_t (lnk_file (read getattr)))
