(allow openwave_system_t openwave_app_t (process (getattr)))
(allow openwave_system_t openwave_app_t (dir (search read open getattr)))
(allow openwave_system_t openwave_app_t (file (read open getattr)))
(allow openwave_system_t openwave_app_t (lnk_file (read getattr)))

; Managed profile parents are distinct from ordinary Documents/Pictures.
