; integration 05: native clients traverse their installed bundles/profile and
; receive keyboard/keymap descriptors from the authenticated compositor.
(allow openwave_native_renderer openwave_app_exec_t (dir (search read open getattr)))
(allow openwave_native_renderer openwave_user_data_t (dir (search read open getattr)))
