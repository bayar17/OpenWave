(allow openwave_application_executable_broker openwave_app_t (file (read)))
(allow openwave_xdg_portal_t openwave_shell_state_t (dir (watch)))

; Native Qt renderers use DRM and shared buffers. Only Ocean handles global
; input and VT control; applications retain the existing render-node policy.
(typeattribute openwave_native_renderer)
(typeattributeset openwave_native_renderer (openwave_shell_t openwave_settings_t openwave_files_t))
(type openwave_input_t)
