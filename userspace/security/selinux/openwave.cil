(allow openwave_broker_identity_consumer openwave_system_domain (file (read open getattr)))
(allow openwave_broker_identity_consumer openwave_system_domain (lnk_file (read getattr)))
; File/prompt brokers verify /proc/<caller>/exe after appd resolves the live
; identity. Confined apps have their own proc label, outside system_domain.
; This permits executable-link verification without opening proc files or
; tracing the application, and grants no application-storage access.
(typeattribute openwave_application_executable_broker)
(typeattributeset openwave_application_executable_broker (openwave_portal_t openwave_promptd_t))
(allow openwave_application_executable_broker openwave_app_t (dir (search getattr)))
(allow openwave_application_executable_broker openwave_app_t (lnk_file (read getattr)))
; selinux_ptrace_access_check(PTRACE_MODE_READ) checks FILE__READ against the
