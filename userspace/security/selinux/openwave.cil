(allow openwave_app_t openwave_app_cgroup_t (dir (search read open getattr)))
(allow openwave_app_t openwave_app_cgroup_t (file (read open getattr)))

; Public supervisor proofs plus proc start times let clients authenticate
; broker bus owners. This authorizes no process tracing or private state reads.
(typeattribute openwave_broker_identity_consumer)
(typeattributeset openwave_broker_identity_consumer (openwave_power_t openwave_connectivity_t))
(typeattributeset openwave_broker_identity_consumer (openwave_appd_t openwave_permissiond_t openwave_portal_t openwave_promptd_t openwave_wallpaper_t openwave_shell_t openwave_xdg_portal_t))
