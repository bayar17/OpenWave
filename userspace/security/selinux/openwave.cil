; Evidence: qt610-core2 enforcing boot. Qt probes the bundle directory,
; discovers input via libudev, and atomically links its private cache files.
(allow openwave_shell_t openwave_app_exec_t (dir (search read open getattr)))
(allow openwave_shell_t openwave_user_data_t (dir (search getattr)))
; Portal 17: the embedded Files picker must list the user's folders and inspect
; selected images. Ownership/DAC and its pinned per-user FilesBackend root still
; apply; this grants no profile mutation or access to broker-private state.
(allow openwave_shell_t openwave_user_data_t (dir (read open)))
(allow openwave_shell_t openwave_user_data_t (file (read open getattr map)))
; Portal 18: the supervised file broker validates the verified user's root,
; inspects MIME headers, and opens read-only image grants. Imported Photos
; live in application storage; no broker-private state is exposed.
(allow openwave_portal_t self (capability (setuid setgid)))
(allow openwave_portal_t openwave_user_data_t (dir (search read open getattr write add_name create)))
(allow openwave_portal_t openwave_user_data_t (file (read open getattr create write)))
(allow openwave_portal_t openwave_app_storage_t (dir (search getattr)))
(allow openwave_portal_t openwave_app_data_t (dir (search read open getattr)))
(allow openwave_portal_t openwave_app_data_t (file (read open getattr)))
; SCM_RIGHTS keeps the broker's descriptor SID while the bus relays the grant.
; D-Bus may relay/read existing descriptors, without permission to open paths.
(allow openwave_dbus_t openwave_portal_t (fd (use)))
; Relaying an O_WRONLY portal descriptor checks write as well as fd use.
; D-Bus still cannot open paths or create/mutate directory entries.
(allow openwave_dbus_t openwave_user_data_t (file (read write)))
(allow openwave_dbus_t openwave_app_data_t (file (read)))
(allow openwave_shell_t openwave_portal_t (fd (use)))
(allow openwave_settings_t openwave_portal_t (fd (use)))
(allow openwave_settings_t openwave_user_data_t (file (read getattr)))
(allow openwave_shell_t self (netlink_kobject_uevent_socket (create read write bind getattr getopt setopt)))
(allow openwave_shell_t openwave_shell_state_t (file (link)))
(typetransition openwave_shell_t openwave_run_t dir openwave_shell_state_t)
; D-Bus GetConnectionCredentials carries pidfds to root QA clients too.
(allow openwave_system_t openwave_dbus_t (fd (use)))

(allow openwave_shell_t openwave_state_t (lnk_file (read getattr)))

; integration 04: trusted renderers consume the launcher's exec/log descriptors
; and inherit its resource limits/signals across the dedicated domain change.
(allow openwave_settings_t openwave_appd_t (fd (use)))
(allow openwave_files_t openwave_appd_t (fd (use)))
(allow openwave_appd_t openwave_settings_t (process (rlimitinh siginh)))
(allow openwave_appd_t openwave_files_t (process (rlimitinh siginh)))
