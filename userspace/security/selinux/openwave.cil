(allow openwave_files_t openwave_app_data_t (sock_file (create read write open getattr setattr unlink rename)))
(allow openwave_appd_t openwave_app_data_t (sock_file (read write open getattr)))
; Public broker proofs require public proc start times; private service state
; and process tracing remain inaccessible to ordinary applications.
(typeattribute openwave_public_identity_broker)
(typeattributeset openwave_public_identity_broker (openwave_appd_t openwave_permissiond_t openwave_portal_t openwave_promptd_t))
(typeattribute openwave_application_identity_client)
(typeattributeset openwave_application_identity_client (openwave_settings_t openwave_files_t openwave_app_t))
(allow openwave_application_identity_client openwave_public_identity_broker (dir (search read open getattr)))
(allow openwave_application_identity_client openwave_public_identity_broker (file (read open getattr)))

; Bubblewrap's temporary root has its own label. Installed runtime stays
; immutable; only the launcher builds and mounts this disposable tree.
(type openwave_sandbox_t)
; selinuxfs control inodes use the fixed security SID in this kernel.
; The separate security-class check permits only context validation.
(allow openwave_appd_t openwave_security_t (file (read write open getattr)))
(neverallow openwave_appd_t openwave_security_t (security (load_policy setenforce setbool)))
(allow openwave_appd_t self (process (setfscreate)))
(allow openwave_appd_t openwave_runtime_t (filesystem (relabelfrom)))
(allow openwave_appd_t openwave_sandbox_t (filesystem (relabelto mount remount unmount getattr)))
(allow openwave_appd_t openwave_default_t (filesystem (remount unmount)))
(allow openwave_appd_t openwave_run_t (dir (mounton)))
(allow openwave_appd_t openwave_app_storage_t (dir (mounton)))
(allow openwave_appd_t openwave_appd_runtime_t (dir (mounton)))
(allow openwave_appd_t openwave_sandbox_t (dir (read open getattr search create write add_name remove_name setattr rmdir mounton)))
(allow openwave_appd_t openwave_sandbox_t (file (read open getattr create write setattr unlink mounton)))
(allow openwave_appd_t openwave_sandbox_t (lnk_file (read getattr create unlink)))
(allow openwave_app_t openwave_sandbox_t (dir (read open search getattr)))
(allow openwave_app_t openwave_sandbox_t (file (read open getattr)))
(allow openwave_app_t openwave_sandbox_t (lnk_file (read getattr)))

; appd owns lifecycle operations for its two trusted native application roles.
; This is the same bounded signal management used for its ordinary app role.
(allow openwave_appd_t openwave_settings_t (process (getattr signal signull sigkill getpgid)))
(allow openwave_appd_t openwave_files_t (process (getattr signal signull sigkill getpgid)))
(allow openwave_settings_t openwave_appd_t (process (sigchld signull)))
(allow openwave_files_t openwave_appd_t (process (sigchld signull)))
; libselinux's context validator is a query, separate from loading policy.
(allow openwave_appd_t openwave_security_t (security (check_context)))

; integration 06: compositor receives native clients' DRM buffer descriptors.
(allow openwave_shell_t openwave_settings_t (fd (use)))
(allow openwave_shell_t openwave_files_t (fd (use)))
; wl_shm cursor pools arrive as O_RDWR descriptors. security_file_receive
; checks both access modes, even though the compositor only maps their pixels.
; Limit this to client-owned anonymous memory, never installed/profile files.
(allow openwave_shell_t openwave_native_renderer (memfd_file (read write getattr map)))
(allow openwave_native_renderer openwave_app_data_t (file (link)))
; Trusted native environments are constructed from a whitelist by appd.
; Ordinary app transitions keep secureexec, no_new_privs and all isolation.
(allow openwave_appd_t openwave_settings_t (process (noatsecure)))
(allow openwave_appd_t openwave_files_t (process (noatsecure)))
; Files owns user file management, subject to the session UID's Unix rights.
(allow openwave_files_t openwave_user_data_t (dir (create write add_name remove_name setattr rmdir watch)))
(allow openwave_files_t openwave_user_data_t (file (create read write append open getattr setattr unlink rename lock map)))
(allow openwave_files_t openwave_user_data_t (lnk_file (create read getattr unlink rename)))
; Retire only managed app-channel sockets from the shared session directory.
(allow openwave_appd_t openwave_run_t (dir (write remove_name)))
(allow openwave_appd_t openwave_app_data_t (sock_file (unlink)))
; integration 07: Bubblewrap mounts its labeled temporary tmpfs. Bind imports
; become read-only per-mount, including the imported pseudo filesystems.
(allow openwave_appd_t openwave_runtime_t (filesystem (mount remount unmount)))
(allow openwave_appd_t openwave_proc_t (filesystem (remount)))
(allow openwave_appd_t openwave_sysfs_t (filesystem (remount)))
(allow openwave_appd_t openwave_security_t (filesystem (remount)))
(allow openwave_appd_t openwave_cgroup_t (filesystem (remount)))
; integration 09: context-labeled nested tmpfs mounts validate the disposable
; sandbox filesystem's existing label as well as the requested label.
(allow openwave_appd_t openwave_sandbox_t (filesystem (relabelfrom)))
; integration 10: ordinary app exec inherits bounded resource limits/signals;
; secureexec remains enabled and service QA logs are not writable by apps.
(allow openwave_appd_t openwave_app_t (process (rlimitinh siginh)))

;; WAYDROID_SIOCGIFINDEX_60_BEGIN
;; iproute2 uses SIOCGIFINDEX to look up a network interface index.
;; Image 59 audit: openwave_waydroid_net_t self:unix_dgram_socket ioctlcmd=0x8933.
;; Keep this limited to the Waydroid network helper and that request number.
(allow openwave_waydroid_net_t self (unix_dgram_socket (ioctl)))
(allowx openwave_waydroid_net_t self (ioctl unix_dgram_socket (0x8933)))
;; WAYDROID_SIOCGIFINDEX_60_END

