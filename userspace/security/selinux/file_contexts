/.* system_u:object_r:openwave_default_t:s0
/init system_u:object_r:openwave_runtime_t:s0
/(usr|lib|lib64|bin|sbin|etc)(/.*)? system_u:object_r:openwave_runtime_t:s0
/etc/selinux(/.*)? system_u:object_r:openwave_private_t:s0
/etc/selinux system_u:object_r:openwave_runtime_t:s0
/etc/selinux/config system_u:object_r:openwave_runtime_t:s0
/System(/.*)? system_u:object_r:openwave_runtime_t:s0
/Applications(/.*)? system_u:object_r:openwave_runtime_t:s0
/Applications/[^/]+/bin(/.*)? system_u:object_r:openwave_app_exec_t:s0
/System/Applications/[^/]+/bin(/.*)? system_u:object_r:openwave_app_exec_t:s0
/Data(/.*)? system_u:object_r:openwave_user_data_t:s0
/Data/Users/[^/]+/\.DataLocation/Applications/[^/]+(/.*)? system_u:object_r:openwave_app_data_t:s0
/var(/.*)? system_u:object_r:openwave_private_t:s0
/var/openwave/wallpaper(/.*)? system_u:object_r:openwave_runtime_t:s0
/var/cache/fontconfig(/.*)? system_u:object_r:openwave_runtime_t:s0
/(run|tmp)(/.*)? system_u:object_r:openwave_runtime_t:s0
/run/openwave/apps/[^/]+(/.*)? system_u:object_r:openwave_app_data_t:s0
/run/openwave/appd(/.*)? system_u:object_r:openwave_private_t:s0
/dev(/.*)? system_u:object_r:openwave_device_t:s0
/dev/(null|zero|random|urandom) system_u:object_r:openwave_null_t:s0
/dev/console system_u:object_r:openwave_console_t:s0
/dev/dri(/.*)? system_u:object_r:openwave_gpu_t:s0
/dev/shm(/.*)? system_u:object_r:openwave_app_data_t:s0

# Linker and libraries: keep service entrypoints separate from shared objects.
# Ordered after the generic runtime mapping so these patterns take precedence.
/(usr/)?lib(64)?(/[^/]+)*/[^/]+\.so(\.[0-9]+)* system_u:object_r:openwave_shared_lib_t:s0
/(System/Applications|Applications)/[^/]+/(lib|plugins|qml)(/[^/]+)*/[^/]+\.so(\.[0-9]+)* system_u:object_r:openwave_shared_lib_t:s0
/(usr/)?lib(64)?/ld-[^/]+\.so(\.[0-9]+)* system_u:object_r:openwave_elf_loader_t:s0
/(usr/)?lib(64)?/ld-[0-9]+(\.[0-9]+)*\.so system_u:object_r:openwave_elf_loader_t:s0
