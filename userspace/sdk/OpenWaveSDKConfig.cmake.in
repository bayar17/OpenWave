@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.10 COMPONENTS Core Gui Network Qml)
set(_openwave_triple "${CMAKE_CXX_COMPILER_TARGET}")
if(NOT _openwave_triple)
    set(_openwave_triple "${OPENWAVE_TARGET_TRIPLE}")
endif()
if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/${_openwave_triple}/OpenWaveSDKTargets.cmake")
    set(OpenWaveSDK_FOUND FALSE)
    set(OpenWaveSDK_NOT_FOUND_MESSAGE "No OpenWave APIs installed for target '${_openwave_triple}'")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/${_openwave_triple}/OpenWaveSDKTargets.cmake")
get_filename_component(OpenWaveSDK_QML_IMPORT_PATH
    "${CMAKE_CURRENT_LIST_DIR}/../../../sysroot/${_openwave_triple}/usr/qml" ABSOLUTE)
foreach(_component IN ITEMS Fonts Prompts FileChooser Applications Wallpaper Time Connectivity SystemControls ApplicationData Xml Identity Permissions ApplicationServices)
    set(OpenWaveSDK_${_component}_FOUND TRUE)
endforeach()
check_required_components(OpenWaveSDK)
unset(_component)
unset(_openwave_triple)
