        <radialGradient id="_Radial1" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="matrix(800,0,0,800,100,500)"><stop offset="0" style="stop-color:rgb(152,152,152);stop-opacity:1"/><stop offset="1" style="stop-color:rgb(72,72,72);stop-opacity:1"/></radialGradient>
    </defs>
</svg>
'''

[[file]]
foreach = "extra_libs"
path = "libs/@lib@/CMakeLists.txt"
content = '''
add_library(@lib@ SHARED src/@lib@.cpp)
target_include_directories(@lib@ PUBLIC include)
set_target_properties(@lib@ PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE
    INSTALL_RPATH "/Applications/@project_id@/lib64;/usr/lib64;/usr/lib")
install(TARGETS @lib@ LIBRARY DESTINATION /Applications/@project_id@/lib64)
'''

[[file]]
foreach = "extra_libs"
path = "libs/@lib@/include/@lib@/@lib@.hpp"
content = '''
#pragma once

#include <string>

namespace @lib@ {

std::string describe();

}  // namespace @lib@
'''

[[file]]
foreach = "extra_libs"
path = "libs/@lib@/src/@lib@.cpp"
content = '''
#include <@lib@/@lib@.hpp>

namespace @lib@ {

std::string describe()
{
    return "library @lib@ is part of @project_name@";
}

}  // namespace @lib@
'''
