
[blueprint]
format = 1
name = "QtQuick"
description = "Qt Quick application: QML window, a C++ backend, CMake build and Application.toml"

[[file]]
path = "Application.toml"
content = '''
schema = 1
id = "@project_id@"
name = "@project_name@"
version = "@project_version@"
kind = "application"
executable = "bin/@project_executable@"
runtime = "openwave-qt"
icon = "share/icons/icon.svg"
single_instance = true
accepts_paths = false

[sandbox]
profile = "standard"

[permissions]
request = []
'''

[[file]]
path = "CMakeLists.txt"
content = '''
cmake_minimum_required(VERSION 3.21)
project(@project_cmake@ VERSION @project_version@ LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
find_package(Qt6 6.10 REQUIRED COMPONENTS Quick)
find_package(OpenWaveSDK REQUIRED COMPONENTS Fonts)
qt_standard_project_setup(REQUIRES 6.10)
@@if extra_libs

@@for lib in extra_libs
add_subdirectory(libs/@lib@)
@@endfor
@@endif

set_source_files_properties(src/Main.qml PROPERTIES QT_RESOURCE_ALIAS Main.qml)
qt_add_executable(@project_executable@ src/Main.cpp include/Main.hpp)
qt_add_qml_module(@project_executable@
    URI @project_module@ VERSION 1.0
    IMPORT_PATH "${OpenWaveSDK_QML_IMPORT_PATH}"
    QML_FILES src/Main.qml)
target_include_directories(@project_executable@ PRIVATE include)
target_link_libraries(@project_executable@ PRIVATE Qt6::Quick OpenWave::Fonts)
@@for lib in extra_libs
target_link_libraries(@project_executable@ PRIVATE @lib@)
@@endfor

include("${OpenWaveSDK_DIR}/OpenWaveBundle.cmake")
openwave_install_bundle(@project_executable@ @project_id@)
install(FILES share/icons/icon.svg DESTINATION /Applications/@project_id@/share/icons)
'''

[[file]]
path = "src/Main.qml"
content = '''
import QtQuick
import OpenWave.Fonts 1.0

Window {
    visible: true
    color: "#1f2a30"
    title: backend.title

    Backend { id: backend }

    Column {
        anchors.centerIn: parent
        spacing: 24
        Image {
            source: "file:///Applications/@project_id@/share/icons/icon.svg"
            width: 160; height: 160
            anchors.horizontalCenter: parent.horizontalCenter
        }
        Text {
            text: backend.title
            color: "white"
            font.family: Fonts.family
            font.pixelSize: 44
            anchors.horizontalCenter: parent.horizontalCenter
        }
        Text {
            text: backend.message
            color: "#a8ffffff"
            font.family: Fonts.family
            font.pixelSize: 26
            anchors.horizontalCenter: parent.horizontalCenter
        }
    }
}
'''

[[file]]
path = "src/Main.cpp"
content = '''
#include "Main.hpp"

#include <OpenWave/FontManager.h>
#include <QGuiApplication>
#include <QQmlApplicationEngine>
@@for lib in extra_libs
#include <@lib@/@lib@.hpp>
@@endfor

Backend::Backend(QObject *parent) : QObject(parent) {}

QString Backend::title() const
{
    return QStringLiteral("@project_name@");
}

QString Backend::message() const
{
@@if extra_libs
    QString text = QStringLiteral("@project_id@ @project_version@");
@@for lib in extra_libs
    text += QStringLiteral("\n") + QString::fromStdString(@lib@::describe());
@@endfor
    return text;
@@else
    return QStringLiteral("@project_id@ @project_version@");
@@endif
}

int main(int argc, char *argv[])
{
    QGuiApplication app(argc, argv);
    OpenWave::FontManager::initialize();
    QQmlApplicationEngine engine;
    QObject::connect(&engine, &QQmlApplicationEngine::objectCreationFailed, &app,
                     [] { QCoreApplication::exit(1); }, Qt::QueuedConnection);
    engine.loadFromModule("@project_module@", "Main");
    return app.exec();
}
'''

[[file]]
path = "include/Main.hpp"
content = '''
#pragma once

#include <QObject>
#include <QString>
#include <QtQml/qqmlregistration.h>

class Backend : public QObject
{
    Q_OBJECT
    QML_ELEMENT
    Q_PROPERTY(QString title READ title CONSTANT)
    Q_PROPERTY(QString message READ message CONSTANT)

public:
    explicit Backend(QObject *parent = nullptr);
    QString title() const;
    QString message() const;
};
'''

