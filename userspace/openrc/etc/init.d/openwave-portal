#!/sbin/openrc-run
description="OpenWave desktop portal"
command="/System/Services/openwave-portal"
command_background="yes"
pidfile="/run/openwave/portal.pid"
output_log="/run/openwave/portal.stdout.log"
error_log="/run/openwave/portal.stderr.log"

start_pre() {
	/System/Services/openwave-register-service-identity --invalidate portal || return 1
}

depend() {
	need dbus openwave-session-bus
}

start_post() {
	/System/Services/openwave-register-service-identity portal || return 1
	/System/Services/openwave-wait-dbus system org.openwave.portal
}

stop_post() {
	/System/Services/openwave-register-service-identity --invalidate portal
}
