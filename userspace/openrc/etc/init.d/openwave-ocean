#!/sbin/openrc-run
description="OceanShell native OpenWave session"
command="/System/Applications/com.openwave.shell/bin/ocean-launcher"
command_user="ocean:ocean"
command_background="yes"
pidfile="/run/openwave/ocean.pid"
no_new_privs="yes"
umask="0077"
output_log="/run/user/1000/openwave-logs/ocean.stdout.log"
error_log="/run/user/1000/openwave-logs/ocean.stderr.log"
export HOME="/var/lib/ocean"
export USER="ocean"
export LOGNAME="ocean"
export OPENWAVE_TRUSTED_SHELL="1"
export XDG_CONFIG_HOME="/var/lib/ocean/.config"
export XDG_STATE_HOME="/var/lib/ocean/.local/state"
export XDG_RUNTIME_DIR="/run/user/1000"
export XDG_CURRENT_DESKTOP="OpenWave"
export DBUS_SYSTEM_BUS_ADDRESS="unix:path=/run/dbus/system_bus_socket"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
export QT_QPA_PLATFORM="eglfs"
export QT_QPA_EGLFS_INTEGRATION="eglfs_kms"
export QT_QPA_EGLFS_ALWAYS_SET_MODE="1"
export QSG_RHI_BACKEND="opengl"
export QT_QPA_EGLFS_KMS_CONFIG="/etc/openwave/kms.json"

configure_qemu_tablet_pointer() {
	local name_path event_name
	for name_path in /sys/class/input/event*/device/name; do
		[ -r "$name_path" ] || continue
		IFS= read -r event_name < "$name_path" || continue
		case "$event_name" in
			*"QEMU USB Tablet"*) ;;
			*) continue ;;
		esac
		event_name=${name_path#/sys/class/input/}
		event_name=${event_name%/device/name}
		case "$event_name" in
			event[0-9]*) ;;
			*) continue ;;
		esac
		[ -e "/dev/input/$event_name" ] || continue
		QT_QPA_EVDEV_MOUSE_PARAMETERS="/dev/input/$event_name:abs"
		export QT_QPA_EVDEV_MOUSE_PARAMETERS
		einfo "Using QEMU absolute pointer at /dev/input/$event_name"
		return 0
	done
	# Physical devices retain Qt's normal input discovery.
	return 0
}

start_pre() {
	case " $(cat /proc/cmdline) " in
		*" openwave.qa=drawer "*) command_args="--drawer" ;;
	esac
	case " $(cat /proc/cmdline) " in
		*" openwave.qa=boot "*)
			export OPENWAVE_QA_GRAPHICS=1
			export QT_LOGGING_RULES="qt.qpa.eglfs.kms.debug=true" ;;
	esac
	local path
	[ ! -L /run/user/1000/openwave-logs ] || {
		eerror "Refusing symlinked Ocean log directory"
		return 1
	}
	[ -d /run/user/1000/openwave-logs ] || {
		eerror "Ocean log directory was not provisioned"
		return 1
	}
	for path in "$output_log" "$error_log"; do
		[ ! -L "$path" ] || {
			eerror "Refusing symlinked Ocean log file: $path"
			return 1
		}
		if [ -e "$path" ] && [ ! -f "$path" ]; then
			eerror "Refusing non-regular Ocean log file: $path"
			return 1
		fi
	done
	configure_qemu_tablet_pointer
	/System/Services/openwave-register-service-identity --invalidate ocean || return 1
}

depend() {
	need openwave-runtime udevd openwave-session-bus appd permissiond promptd wallpaperagentd powerd openwave-portal xdg-desktop-portal-openwave
	use pipewire wireplumber audiod
}

start_post() {
	/System/Services/openwave-register-service-identity ocean || return 1
	/System/Services/openwave-wait-dbus system org.openwave.Shell
}

stop_post() {
	/System/Services/openwave-register-service-identity --invalidate ocean
}
