#!/sbin/openrc-run
description="Ocean user PipeWire server"
command="/usr/bin/pipewire"
command_user="ocean:ocean"
command_background="yes"
pidfile="/run/user/1000/pipewire.pid"
export XDG_RUNTIME_DIR="/run/user/1000"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"

depend() {
	need openwave-session-bus
}
