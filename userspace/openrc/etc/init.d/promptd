#!/sbin/openrc-run
description="OpenWave prompt service"
command="/System/Services/promptd"
command_background="yes"
pidfile="/run/openwave/promptd.pid"
output_log="/run/openwave/promptd.stdout.log"
error_log="/run/openwave/promptd.stderr.log"
export XDG_RUNTIME_DIR="/run/user/1000"
export DBUS_SYSTEM_BUS_ADDRESS="unix:path=/run/dbus/system_bus_socket"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"

depend() {
	need dbus openwave-session-bus
}

start_pre() {
	/System/Services/openwave-register-service-identity --invalidate promptd || return 1
}

start_post() {
	/System/Services/openwave-register-service-identity promptd || return 1
	/System/Services/openwave-wait-dbus session org.openwave.Prompt
}

stop_post() {
	/System/Services/openwave-register-service-identity --invalidate promptd
}
