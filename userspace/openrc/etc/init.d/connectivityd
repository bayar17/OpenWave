#!/sbin/openrc-run
description="OpenWave connectivity service"
command="/System/Services/connectivityd"
command_background="yes"
pidfile="/run/openwave/connectivityd.pid"

depend() {
	need dbus NetworkManager
}
start_pre() {
    /System/Services/openwave-register-service-identity --invalidate connectivityd || return 1
}
start_post() {
    /System/Services/openwave-register-service-identity connectivityd || return 1
    /System/Services/openwave-wait-dbus system org.openwave.Connectivity
}
stop_post() {
    /System/Services/openwave-register-service-identity --invalidate connectivityd
}
