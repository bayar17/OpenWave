#!/bin/sh
# Start Android (Waydroid) for the Ocean session. Opt-in: Waydroid stays an
# optional service outside the default runlevel, and this runs only with
# openwave.android=1 on the kernel command line. The QA run
# (openwave.qa=waydroid) drives the same steps itself and takes precedence.
#
# Same sequence the Stage 8 acceptance run used, in OpenRC's own domain:
# provision, initialize once from the preinstalled images, start the
# manager, and ask it to start the container for the Ocean session.
case " $(cat /proc/cmdline) " in *' openwave.qa=waydroid '*) exit 0 ;; esac
case " $(cat /proc/cmdline) " in *' openwave.android=1 '*) ;; *) exit 0 ;; esac
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
export PYTHONDONTWRITEBYTECODE=1
LOG=/run/openwave/android-start.log
exec >>"$LOG" 2>&1
say() { printf 'openwave-android: %s\n' "$*"; printf 'openwave-android: %s\n' "$*" >/dev/console; }
fail() { say "FAILED: $*"; exit 1; }

# local.d runs while the default runlevel is still starting, when OpenRC does
# not start "need" dependencies on demand; start each service explicitly.
/sbin/rc-service waydroid-runtime start || fail "runtime provisioning"
if [ ! -f /var/lib/waydroid/waydroid.cfg ]; then
    [ -s /usr/share/waydroid-extra/images/system.img ] && [ -s /usr/share/waydroid-extra/images/vendor.img ] \
        || fail "no preinstalled Android images"
    say "first start: initializing Waydroid from the preinstalled images"
    # Upstream recognizes this location without downloading anything.
    /usr/bin/waydroid init -i /usr/share/waydroid-extra/images \
        -c https://waydroid-atv.github.io/ota/a17-qpr0/system \
        -v https://waydroid-atv.github.io/ota/a17-qpr0/vendor \
        -r lineage -s GAPPS || fail "waydroid init"
    # init records the binder device names; recreate the devices and the
    # container's device allowances to match (configuration is unchanged).
    /usr/bin/umount /dev/binderfs
    /usr/bin/python3.14 -I /usr/libexec/openwave-waydroid-binder.py || fail "binder devices"
fi
/sbin/rc-service pipewire-pulse start || fail "pipewire-pulse"
/sbin/rc-service waydroid start || fail "Waydroid manager"
/System/Services/openwave-wait-dbus system id.waydro.Container || fail "Waydroid manager is not on the bus"
/lib/rc/bin/checkpath -d -o waydroid:waydroid -m 0700 /var/lib/waydroid-user/data || fail "Android data directory"
# Android's composer connects to Ocean's Wayland socket when it starts.
tries=0
while [ ! -S /run/user/1000/wayland-0 ] && [ "$tries" -lt 60 ]; do
    /bin/busybox sleep 1; tries=$((tries + 1))
done
[ -S /run/user/1000/wayland-0 ] || fail "Ocean's Wayland socket did not appear"
/usr/bin/python3.14 - <<'PY' || fail "container start"
import os
import dbus

assert os.getuid() == os.geteuid() == 0
session = {
    'user_name': 'waydroid', 'user_id': '990', 'group_id': '990',
    'host_user': '/var/lib/waydroid-user', 'pid': str(os.getpid()),
    'xdg_data_home': '/var/lib/waydroid-user',
    'xdg_runtime_dir': '/run/waydroid',
    'wayland_display': '/run/user/1000/wayland-0',
    'pulse_runtime_path': '/run/user/1000/pulse',
    'waydroid_user_state': '/var/lib/waydroid-user',
    'waydroid_data': '/var/lib/waydroid-user/data',
    'state': 'STOPPED', 'lcd_density': '0', 'background_start': 'true',
}
manager = dbus.Interface(dbus.SystemBus().get_object(
    'id.waydro.Container', '/ContainerManager'), 'id.waydro.ContainerManager')
manager.Start(dbus.Dictionary(session, signature='ss'), timeout=120)
PY
say "Android container started; applications appear in Ocean once Android has booted"
