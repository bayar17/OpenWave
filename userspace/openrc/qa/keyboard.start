#!/bin/sh
case " $(cat /proc/cmdline) " in *' openwave.qa=keyboard '*) ;; *) exit 0 ;; esac
exec >/dev/console 2>&1
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
printf 'KEYBOARD_QA BEGIN enforcing=%s\n' "$(cat /sys/fs/selinux/enforce)"
cat /proc/bus/input/devices
shell_log=/run/user/1000/openwave-logs/ocean.stderr.log
app_log=/run/openwave/appd.stderr.log
wait_for() {
    attempt=0
    while ! grep -q "$1" "$2" 2>/dev/null; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 140 ]; then
            printf 'KEYBOARD_QA_FAIL waiting for %s\n' "$1"
            tail -60 "$shell_log" "$app_log"
            return 1
        fi
        sleep 0.25
    done
}
wait_for 'KEYBOARD_QA_READY shell' "$shell_log" || exit 1
printf 'KEYBOARD_QA_READY shell\n'
wait_for 'KEYBOARD_QA_PASS shell' "$shell_log" || exit 1
printf 'KEYBOARD_QA_PASS shell hardware text/editing\n'
/System/Services/openwave-launch com.openwave.settings || exit 1
wait_for 'OCEAN_QA surface-present appId=com.openwave.settings' "$shell_log" || exit 1
# The confined child's private stdout is flushed by appd when it exits.
# Give the visible client time to focus its actual search TextInput.
sleep 3
printf 'KEYBOARD_QA_READY client\n'
wait_for 'KEYBOARD_QA_PASS client' "$app_log" || exit 1
tail -20 "$app_log"
if [ "$(cat /sys/fs/selinux/enforce)" = 1 ]; then
    printf 'KEYBOARD_QA PASS hardware keyboard in Ocean and Settings enforcing=1\n'
else
    printf 'KEYBOARD_QA_FAIL SELinux not enforcing\n'
fi
