#!/bin/sh
# Opt-in serial evidence only; no policy or service state changes.
case " $(cat /proc/cmdline) " in
    *" openwave.qa=boot "*) ;;
    *) exit 0 ;;
esac
exec >/dev/console 2>&1
echo 'OPENWAVE_BOOT_REPORT_BEGIN'
printf 'SELinux enforcing: '; cat /sys/fs/selinux/enforce
printf '\nPID 1 context: '; cat /proc/1/attr/current
printf '\nPID 1 executable: '; readlink /proc/1/exe
/usr/bin/rc-status -a
printf '\nSystem bus probe: '
DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket /usr/bin/gdbus call --system --timeout 2 --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.ListNames
printf '\nSession bus probe: '
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus /usr/bin/gdbus call --session --timeout 2 --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.ListNames
for file in /run/openwave/*.pid /run/user/1000/dbus.pid; do
    [ -f "$file" ] || continue
    pid=$(cat "$file")
    case "$pid" in *[!0-9]*|'') continue;; esac
    printf '\nProcess %s: ' "$file"
    cat "/proc/$pid/attr/current"
    readlink "/proc/$pid/exe"
done
for file in /run/openwave/*.log /run/user/1000/openwave-logs/*.log; do
    [ -f "$file" ] || continue
    printf '\nLOG %s\n' "$file"
    tail -60 "$file"
done
echo 'OPENWAVE_BOOT_REPORT_END'
