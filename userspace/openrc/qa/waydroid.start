        echo "first_run=$(/bin/busybox ps -o args | /bin/busybox grep -c "[o]penwave-waydroid-first-run")"
        echo "lxc_processes=$(/bin/busybox ps -o args | /bin/busybox grep -cE "^(/usr/bin/)?lxc-(start|attach)")"
        echo "waydroid_mounts=$(/bin/busybox grep -c " /var/lib/waydroid" /proc/self/mountinfo)"
        /usr/bin/gdbus call --system --timeout 5 --dest org.openwave.Applications --object-path /org/openwave/Applications --method org.openwave.Applications1.ListApplications | /bin/busybox grep -o "org\.openwave\.android\.[A-Za-z0-9_.]*.\{0,400\}" | /bin/busybox grep -o "launchable.: <[a-z]*>" | /bin/busybox sort | /bin/busybox uniq -c
        /bin/busybox grep -E "Android (session|event watcher)" /run/openwave/appd.stderr.log | /bin/busybox tail -n 3'
    shot after-android-stop
    probe remember_restart_appd /bin/sh -c '/sbin/rc-service appd restart; /bin/busybox sleep 5; /sbin/rc-service appd status'
    probe remember_after_restart /bin/sh -c 'L=$(/usr/bin/gdbus call --system --timeout 5 --dest org.openwave.Applications --object-path /org/openwave/Applications --method org.openwave.Applications1.ListApplications 2>&1); echo "android_after_restart=$(printf "%s" "$L" | /bin/busybox grep -o "kind.: <.android" | /bin/busybox wc -l)"; echo "launchable_false=$(printf "%s" "$L" | /bin/busybox grep -o "launchable.: <false" | /bin/busybox wc -l)"; /bin/busybox ls -la /var/lib/openwave/app-identities/android | /bin/busybox head -n 6; /bin/busybox grep -E "remembered|restored|could not remember" /run/openwave/appd.stderr.log | /bin/busybox tail -n 3'
else
    printf 'WAYDROID_QA framework=BLOCKED container-not-running\n'
    # Read-only post-failure inventory. A failed upstream OverlayFS mount
    # must not be "fixed" by creating or relabeling arbitrary paths here.
    for path in /var/lib/waydroid/overlay /var/lib/waydroid/overlay/vendor \
        /var/lib/waydroid/overlay_rw/system /var/lib/waydroid/overlay_rw/vendor \
        /var/lib/waydroid/overlay_work/system /var/lib/waydroid/overlay_work/vendor; do
        if [ -d "$path" ]; then
            printf 'WAYDROID_QA overlay_path=%s status=directory\n' "$path"
        else
            printf 'WAYDROID_QA overlay_path=%s status=missing-or-inaccessible\n' "$path"
        fi
    done
    printf 'WAYDROID_QA mountinfo START\n'
    /bin/busybox grep -E '/var/lib/waydroid/(rootfs|overlay)|/dev/binderfs' /proc/self/mountinfo || true
    printf 'WAYDROID_QA mountinfo END\n'
    for log in /var/lib/waydroid/lxc/waydroid.log /var/log/lxc/waydroid.log; do
        [ -f "$log" ] || continue
        printf 'WAYDROID_QA LXC_LOG %s\n' "$log"
        /bin/busybox tail -n 120 "$log"
    done
fi
for log in /run/openwave/waydroid.stdout.log /run/openwave/waydroid.stderr.log /var/lib/waydroid/waydroid.log /run/waydroid-lxc/dnsmasq.log; do
    [ -f "$log" ] || continue
    printf 'WAYDROID_QA LOG %s\n' "$log"
    /bin/busybox tail -80 "$log"
done
printf 'WAYDROID_QA END enforcing=%s\n' "$(cat /sys/fs/selinux/enforce)"
