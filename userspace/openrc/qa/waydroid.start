import os, time
b = "/Data/Users/ocean/AndroidData"
for _ in range(20):
    if os.path.exists(b + "/OpenWaveQA/hello.txt"): break
    time.sleep(2)
print("host label:", os.getxattr(b, "security.selinux").decode().strip("\0"))
st = os.stat(b); print("host dir: mode=%o uid=%d gid=%d" % (st.st_mode, st.st_uid, st.st_gid))
print("host listing:", sorted(os.listdir(b)))
print([l.split()[4] for l in open("/proc/self/mountinfo") if "AndroidData" in l.split()[4]])
os.setgroups([1023]); os.setgid(1000); os.setuid(1000)
print("ocean lists OpenWaveQA:", sorted(os.listdir(b + "/OpenWaveQA")))
'
