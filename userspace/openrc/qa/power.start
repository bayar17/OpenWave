#!/bin/sh
case " $(cat /proc/cmdline) " in
    *' openwave.qa=poweroff '*) action=poweroff ;;
    *' openwave.qa=reboot '*) action=reboot ;;
    *) exit 0 ;;
esac
exec >/dev/console 2>&1
response=$(DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket /usr/bin/gdbus call --system --timeout 3 \
    --dest org.openwave.Power --object-path /org/openwave/Power --method org.openwave.Power1.PowerOff 2>&1)
if [ "$?" = 0 ]; then
    printf 'POWER_QA FAIL unauthorized root caller accepted\n'
    exit 1
else
    case "$response" in
        *org.openwave.Power.Unauthorized*) printf 'POWER_QA unauthorized-root-rejected\n' ;;
        *) printf 'POWER_QA FAIL service unavailable: %s\n' "$response"; exit 1 ;;
    esac
fi
boot_id=$(cat /proc/sys/kernel/random/boot_id)
if [ "$action" = reboot ]; then
    directory=/var/lib/openwave-power-qa
    [ ! -L "$directory" ] || exit 1
    mkdir -p "$directory" || exit 1
    if [ -f "$directory/first-boot" ]; then
        previous=$(cat "$directory/first-boot")
        [ "$previous" != "$boot_id" ] || exit 0
        action=poweroff
    else
        printf '%s\n' "$boot_id" > "$directory/first-boot" || exit 1
        sync
    fi
fi
printf 'POWER_QA BOOT id=%s action=%s enforcing=%s\n' "$boot_id" "$action" "$(cat /sys/fs/selinux/enforce)"
printf '%s\n' "$action" > /run/openwave/power-qa-action
# The default runlevel must finish before openrc-init creates its command FIFO.
# Observe in the background; never block PID 1 waiting for that FIFO.
(
    seen=0
    while [ "$seen" -lt 240 ]; do
        for file in /run/user/1000/openwave-logs/ocean.stderr.log /run/openwave/powerd.stdout.log /run/openwave/powerd.stderr.log; do
            [ -f "$file" ] || continue
            grep -E 'POWER_QA|POWER_UI|POWER_ACTION|powerd:|Power action failed:' "$file"
        done
        seen=$((seen + 1))
        sleep 0.25
    done
) &
exit 0
