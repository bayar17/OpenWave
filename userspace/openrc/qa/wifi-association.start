#!/bin/sh
case " $(cat /proc/cmdline) " in *' openwave.qa=wifi-associate '*) ;; *) exit 0 ;; esac
exec >/dev/console 2>&1
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
printf 'WIFI_ASSOC BEGIN saved profile, physical USB only\n'
nmcall() {
    object=$1; method=$2; shift 2
    /usr/bin/gdbus call --system --timeout 5 --dest org.freedesktop.NetworkManager \
        --object-path "$object" --method "$method" "$@"
}
manager=/org/freedesktop/NetworkManager
nmcall "$manager" org.freedesktop.NetworkManager.SetLogging DEBUG CORE,DEVICE,WIFI,PLATFORM,IP4,DHCP4,DISPATCH
device=
attempt=0
while [ "$attempt" -lt 60 ] && [ -z "$device" ]; do
    devices=$(nmcall "$manager" org.freedesktop.NetworkManager.GetDevices 2>&1)
    for path in $(printf '%s\n' "$devices" | sed 's/[^a-zA-Z0-9_\/]\{1,\}/ /g'); do
        case "$path" in /org/freedesktop/NetworkManager/Devices/*) ;; *) continue ;; esac
        kind=$(nmcall "$path" org.freedesktop.DBus.Properties.Get org.freedesktop.NetworkManager.Device DeviceType 2>&1)
        case "$kind" in *'uint32 2'*) device=$path; break ;; esac
    done
    attempt=$((attempt + 1)); [ -n "$device" ] || sleep 0.25
done
profile=
profiles=$(nmcall "$manager/Settings" org.freedesktop.NetworkManager.Settings.ListConnections 2>&1)
for path in $(printf '%s\n' "$profiles" | sed 's/[^a-zA-Z0-9_\/]\{1,\}/ /g'); do
    case "$path" in /org/freedesktop/NetworkManager/Settings/*) ;; *) continue ;; esac
    # GetSettings omits secrets. Never call GetSecrets or print profile bytes.
    settings=$(nmcall "$path" org.freedesktop.NetworkManager.Settings.Connection.GetSettings 2>&1)
    case "$settings" in *"'type': <'802-11-wireless'>"*) profile=$path; break ;; esac
done
if [ -n "$device" ] && [ -n "$profile" ]; then
    nmcall "$device" org.freedesktop.NetworkManager.Device.Wireless.RequestScan '{}'
    # Cold-boot activation needs a populated iwd AP cache, just like tapping
    # a visible network in Settings. Do not activate before the scan completes.
    sleep 12
    /usr/bin/gdbus call --system --timeout 5 --dest org.openwave.Connectivity \
        --object-path /org/openwave/Connectivity --method org.openwave.Connectivity1.ListWifiNetworks
    nmcall "$manager" org.freedesktop.NetworkManager.ActivateConnection "$profile" "$device" /
else
    printf 'WIFI_ASSOC FAIL missing saved Wi-Fi profile or USB device\n'
fi
attempt=0
connected=0
while [ "$attempt" -lt 18 ]; do
    state=$(/usr/bin/gdbus call --system --timeout 5 --dest org.openwave.Connectivity \
        --object-path /org/openwave/Connectivity --method org.openwave.Connectivity1.GetState 2>&1)
    printf 'WIFI_ASSOC STATE %s\n' "$state"
    [ -z "$device" ] || nmcall "$device" org.freedesktop.DBus.Properties.Get org.freedesktop.NetworkManager.Device StateReason
    tail -35 /run/openwave/networkmanager.stderr.log
    case "$state" in *"'wifiState': <'Connected'>"*) connected=1; break ;; esac
    attempt=$((attempt + 1)); sleep 5
done
for file in /run/openwave/iwd.*.log /run/openwave/networkmanager.*.log; do
    [ -f "$file" ] || continue
    printf '\nWIFI_ASSOC LOG %s\n' "$file"; tail -150 "$file"
done
printf '\nWIFI_ASSOC routes\n'; cat /proc/net/route
printf '\nWIFI_ASSOC DNS\n'; cat /etc/resolv.conf
if [ "$connected" = 1 ]; then
    lease=$(nmcall "$device" org.freedesktop.DBus.Properties.Get org.freedesktop.NetworkManager.Device Dhcp4Config 2>&1)
    case "$lease" in
        *'/org/freedesktop/NetworkManager/DHCP4Config/'*) ;;
        *) printf 'WIFI_ASSOC FAIL no DHCP4 configuration\n'; exit 1 ;;
    esac
    /System/Services/openwave-launch com.openwave.photos
    sleep 12
    /usr/bin/gdbus call --system --timeout 3 --dest org.openwave.Applications \
        --object-path /org/openwave/Applications --method org.openwave.Applications1.Terminate com.openwave.photos
    sleep 2
    grep 'WIFI_ASSOC_APP_DNS' /run/openwave/appd.stderr.log
    if grep -q 'WIFI_ASSOC_APP_DNS_PASS' /run/openwave/appd.stderr.log \
        && ! grep -q 'WIFI_ASSOC_APP_DNS_FAIL' /run/openwave/appd.stderr.log; then
        printf 'WIFI_ASSOC PASS associated, DHCP and DNS\n'
    else
        printf 'WIFI_ASSOC FAIL confined application DNS lookup\n'
    fi
else
    printf 'WIFI_ASSOC FAIL connection did not activate\n'
fi
