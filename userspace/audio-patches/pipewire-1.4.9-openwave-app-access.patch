diff --git a/src/pipewire/global.c b/src/pipewire/global.c
index c9975f9..2eabc32 100644
--- a/src/pipewire/global.c
+++ b/src/pipewire/global.c
@@ -22,13 +22,54 @@ struct impl {
 };
 /** \endcond */
 
+SPA_EXPORT uint32_t pw_openwave_access_policy_version(void)
+{
+	return 1;
+}
+
+static uint32_t openwave_permissions(struct pw_global *global, struct pw_impl_client *client, uint32_t permissions)
+{
+	const char *uid = pw_properties_get(client->properties, PW_KEY_SEC_UID);
+	struct pw_impl_node *node = NULL;
+	struct pw_impl_port *port = NULL;
+	uint32_t owner;
+	if (geteuid() != 0 || (uid && spa_streq(uid, "0")))
+		return permissions;
+	if (uid == NULL)
+		return 0;
+	if (spa_streq(global->type, PW_TYPE_INTERFACE_Core) || global == client->global)
+		return permissions;
+	if (spa_streq(global->type, PW_TYPE_INTERFACE_Factory)) {
+		const char *name = pw_properties_get(global->properties, PW_KEY_FACTORY_NAME);
+		return name && spa_streq(name, "client-node") ? permissions & (PW_PERM_R | PW_PERM_X) : 0;
+	}
+	if (spa_streq(global->type, PW_TYPE_INTERFACE_Node))
+		node = global->object;
+	else if (spa_streq(global->type, PW_TYPE_INTERFACE_Port)) {
+		port = global->object;
+		node = port->node;
+	}
+	if (node) {
+		const char *id = pw_properties_get(node->properties, PW_KEY_CLIENT_ID);
+		const char *media = pw_properties_get(node->properties, PW_KEY_MEDIA_CLASS);
+		if (id && client->global && spa_atou32(id, &owner, 0) && owner == client->global->id)
+			return permissions & ~PW_PERM_L;
+		if (port && port->direction != PW_DIRECTION_INPUT)
+			return 0;
+		return media && spa_streq(media, "Audio/Sink") ? permissions & (PW_PERM_R | PW_PERM_X) : 0;
+	}
+	if (spa_streq(global->type, "PipeWire:Interface:Metadata"))
+		return permissions & PW_PERM_R;
+	return 0;
+}
+
 SPA_EXPORT
 uint32_t pw_global_get_permissions(struct pw_global *global, struct pw_impl_client *client)
 {
 	uint32_t permissions = global->permission_mask;
 	if (client->permission_func != NULL)
 		permissions &= client->permission_func(global, client, client->permission_data);
-	return permissions;
+	return openwave_permissions(global, client, permissions);
 }
 
 /** Create a new global
@@ -346,6 +387,9 @@ int pw_global_update_permissions(struct pw_global *global, struct pw_impl_client
 	struct pw_resource *resource, *t;
 	bool do_hide, do_show;
 
+	old_permissions = openwave_permissions(global, client, old_permissions);
+	new_permissions = openwave_permissions(global, client, new_permissions);
+
 	do_hide = PW_PERM_IS_R(old_permissions) && !PW_PERM_IS_R(new_permissions);
 	do_show = !PW_PERM_IS_R(old_permissions) && PW_PERM_IS_R(new_permissions);
 
