# Relocatable SDK toolchain; host programs and target libraries are distinct.
get_filename_component(OPENWAVE_SDK "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(OPENWAVE_TARGET_TRIPLE "@TRIPLE@" CACHE STRING "OpenWave target triple")
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "@PROCESSOR@")
set(CMAKE_SYSROOT "${OPENWAVE_SDK}/sysroot/${OPENWAVE_TARGET_TRIPLE}")
set(CMAKE_C_COMPILER "${OPENWAVE_SDK}/bin/clang")
set(CMAKE_CXX_COMPILER "${OPENWAVE_SDK}/bin/clang++")
set(CMAKE_ASM_COMPILER "${OPENWAVE_SDK}/bin/clang")
set(CMAKE_C_COMPILER_TARGET "${OPENWAVE_TARGET_TRIPLE}")
set(CMAKE_CXX_COMPILER_TARGET "${OPENWAVE_TARGET_TRIPLE}")
set(CMAKE_ASM_COMPILER_TARGET "${OPENWAVE_TARGET_TRIPLE}")
foreach(pair IN ITEMS "AR;llvm-ar" "RANLIB;llvm-ranlib" "NM;llvm-nm" "STRIP;llvm-strip" "OBJCOPY;llvm-objcopy" "LINKER;ld.lld")
    list(GET pair 0 variable)
    list(GET pair 1 binary)
    set(CMAKE_${variable} "${OPENWAVE_SDK}/bin/${binary}")
endforeach()
set(QT_HOST_PATH "${OPENWAVE_SDK}" CACHE PATH "Host Qt development tools" FORCE)
set(QT_HOST_PATH_CMAKE_DIR "${QT_HOST_PATH}/lib/cmake" CACHE PATH "Host Qt CMake metadata" FORCE)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${OPENWAVE_SDK}")
list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_SYSROOT}/usr" "${OPENWAVE_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib64/pkgconfig:${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
