sif /init mode 0100755
write "$QA_OUTPUT/tests/browser-input-tests" /usr/libexec/browser-input-tests
sif /usr/libexec/browser-input-tests mode 0100755
write "$QA_OUTPUT/input-test.desktop" /usr/share/applications/input-test.desktop
sif /usr/share/applications/input-test.desktop mode 0100644
write "$OPENWAVE_SYSROOT/usr/lib/libQt6Test.so.6" /usr/lib/libQt6Test.so.6
EOF
debugfs -w -f "$QA_COMMANDS" "$QA_IMAGE"
./run-openwave --image "$QA_IMAGE" --usb-wifi none --usb-bluetooth none \
    --audio-backend none --vnc-host 127.0.0.1 --vnc-port "${BROWSER_INPUT_VNC_PORT:-5910}" run \
    > "$QA_OUTPUT/qemu.log" 2>&1
rg -q 'BROWSER_INPUT_QA_EXIT=0' "$QA_OUTPUT/qemu.log"
echo "Browser input QEMU validation passed: $QA_OUTPUT/qemu.log"
)

COMMAND="${1:-help}"
if (($#)); then shift; fi
if [[ "$COMMAND" == help || "$COMMAND" == --help || "$COMMAND" == -h || "${1:-}" == --help || "${1:-}" == -h ]]; then
    usage
    exit 0
fi
case "$COMMAND" in
    audio|bluetooth-audio|mdns|sdk|tzdata|llvm-patch|llvm)
        if (($# != 0)); then usage >&2; exit 2; fi
        ;;
    browser-engine)
        if (($# > 1)); then usage >&2; exit 2; fi
        case "${1:-all}" in all|deps|media|engine) ;; *) usage >&2; exit 2 ;; esac
        ;;
    userspace|all)
        if (($# != 0)) && [[ $# != 2 || "$1" != --image || -z "$2" ]]; then usage >&2; exit 2; fi
        ;;
    image)
        if (($# != 2)); then usage >&2; exit 2; fi
        ;;
    test-appd|test-browser-input)
        if (($# != 1)); then usage >&2; exit 2; fi
        ;;
    *) usage >&2; exit 2 ;;
esac
"build_${COMMAND//-/_}" "$@"
