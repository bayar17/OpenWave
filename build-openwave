build_image() (
# fakeroot is only a metadata tool here, never the deployable staging directory.
RUNTIME_INPUT="${1:?Usage: ./build-openwave image ROOTFS NEW_IMAGE}"
while [[ "$RUNTIME_INPUT" != / && "$RUNTIME_INPUT" == */ ]]; do
    RUNTIME_INPUT="${RUNTIME_INPUT%/}"
done
if [[ -L "$RUNTIME_INPUT" ]]; then
    echo "Refusing symlinked runtime root: $RUNTIME_INPUT" >&2
    exit 1
fi
RUNTIME="$(realpath -- "$RUNTIME_INPUT")"
IMAGE="${2:?Specify a new image path}"
[[ -f "$RUNTIME/init" && -f "$RUNTIME/System/Applications/com.openwave.shell/bin/ocean-launcher" ]]
if [[ -e "$IMAGE" || -L "$IMAGE" ]]; then
    echo "Refusing to overwrite existing image: $IMAGE" >&2
    exit 1
fi
python3 "$ROOT/scripts/prepare-openwave-boot.py" --rootfs "$RUNTIME" \
    --sdk "${OPENWAVE_SDK:-$ROOT/toolchain}" \
    --target "${OPENWAVE_TARGET_TRIPLE:-x86_64-unknown-openwave}"
OPENWAVE_OPENRC_ROOT="$RUNTIME" python3 "$ROOT/userspace/openrc/validate_openrc.py"
mkdir -p -- "$(dirname -- "$IMAGE")"
TEMP_IMAGE="$(mktemp "${IMAGE}.tmp.XXXXXX")"
LABELED_IMAGE="${TEMP_IMAGE}.labeled"
trap 'rm -f -- "$TEMP_IMAGE" "$LABELED_IMAGE"' EXIT
truncate -s "${OPENWAVE_IMAGE_SIZE:-2G}" "$TEMP_IMAGE"
OPENWAVE_IMAGE_BUILDER_UID="$(id -u)" OPENWAVE_IMAGE_BUILDER_GID="$(id -g)" fakeroot -- bash -Eeuo pipefail -c '
    python3 "$3" "$1"
    if [[ -x "$1/usr/libexec/dbus-daemon-launch-helper" ]]; then
        messagebus_gid="$(awk -F: '\''$1 == "messagebus" { print $3; exit }'\'' "$1/etc/group")"
        [[ "$messagebus_gid" =~ ^[0-9]+$ ]]
        chown 0:"$messagebus_gid" "$1/usr/libexec/dbus-daemon-launch-helper"
        chmod 4750 "$1/usr/libexec/dbus-daemon-launch-helper"
    fi
    mke2fs -q -t ext4 -L OpenWave -d "$1" "$2"
' _ "$RUNTIME" "$TEMP_IMAGE" "$ROOT/scripts/image-owners.py"
debugfs -w -R 'sif <2> mode 040755' "$TEMP_IMAGE" >/dev/null
e2fsck -fn "$TEMP_IMAGE"
python3 "$ROOT/scripts/build-openwave-selinux.py" --verify-only \
    --sdk "${OPENWAVE_SDK:-$ROOT/toolchain}" \
    --target "${OPENWAVE_TARGET_TRIPLE:-x86_64-unknown-openwave}" --stage "$RUNTIME"
python3 "$ROOT/scripts/openwave-label-ext4.py" --rootfs "$RUNTIME" \
    --image "$TEMP_IMAGE" --output "$LABELED_IMAGE"
python3 "$ROOT/scripts/build-openwave-selinux.py" --verify-only \
    --sdk "${OPENWAVE_SDK:-$ROOT/toolchain}" \
    --target "${OPENWAVE_TARGET_TRIPLE:-x86_64-unknown-openwave}" --stage "$RUNTIME"
ln -- "$LABELED_IMAGE" "$IMAGE"
mv -- "${LABELED_IMAGE}.label.log" "${IMAGE}.label.log"
echo "Created runtime image: $IMAGE"
)

