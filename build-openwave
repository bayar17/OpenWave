#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'HELP'
Usage: ./build-openwave COMMAND [OPTIONS]

  all                            Patch/build LLVM, dependencies, kernel and userspace
  llvm                          Patch/build/install the native Clang/LLVM compiler
  sysroot                       Bootstrap Linux/glibc headers, compiler-rt builtins, then full glibc
  cross-files                   Regenerate SDK-local Meson/CMake machine files
  graphics                      Build Mesa EGL/GLES2 into target sysroot
  userspace                      Build system apps/services into staging only
  openrc [--clean]              Cross-build and stage OpenRC only (no rootfs/image)
  sdk                           Build and install the public API client libraries
  kernel                        Build the kernel with application isolation enabled
  llvm-patch                    Initialize LLVM sources and apply the OpenWave patch
  browser-engine [all|deps|media|engine]
                                Download/build browser codecs and/or build WPE
  audio                         Download/build ALSA, PipeWire, WirePlumber and audio kernel
  bluetooth-audio               Build Bluetooth audio dependencies
  mdns                          Download/build Avahi and its dependencies
  waydroid-host-deps            Stage pinned Waydroid, iproute2, and networking tools
  waydroid-bindings             Build target Python GI bindings against the SDK
  selinux                       Build SELinux libraries and OpenWave policy
  bubblewrap                    Download/build Bubblewrap and libcap into rootfs
  tzdata                        Install time zone data into runtime staging
  rootfs                        Assemble runtime files into rootfs (no image)
  image ROOTFS NEW_IMAGE        Create a new ext4 image; never overwrite one
  test-permissions NEW_TEST_IMAGE
                                Build and test permission enforcement in QEMU
  test-appd NEW_TEST_IMAGE       Build and run application daemon tests in QEMU
  test-selinux NEW_TEST_IMAGE    Build and test SELinux confinement in QEMU
  test-browser-input NEW_TEST_IMAGE
                                Build and run browser pointer tests in QEMU

Source env.sh for the Qt application development environment.
Launch images with run-openwave. SDK export remains scripts/export-openwave-sdk.py.
HELP
}

prepare_llvm() {
    local source="$ROOT/llvm-project" patch="$ROOT/patches/llvm/openwave-llvm.patch"
    if [[ ! -f "$patch" ]]; then
        echo "Missing OpenWave LLVM patch: $patch" >&2
        return 1
    fi
    if [[ ! -e "$source/.git" ]]; then
        git -C "$ROOT" submodule update --init --depth 1 -- llvm-project
    fi
    if git -C "$source" apply --reverse --check "$patch" 2>/dev/null; then
        echo "OpenWave LLVM patch already applied."
        return 0
    fi
    if ! git -C "$source" apply --check "$patch"; then
        echo "OpenWave LLVM patch conflicts with this checkout; stopping without changing its files." >&2
        return 1
    fi
    git -C "$source" apply --whitespace=nowarn "$patch"
    echo "Applied OpenWave LLVM patch."
}

build_llvm_patch() (
    prepare_llvm
)

build_llvm() (
    prepare_llvm
    SDK="${OPENWAVE_SDK:-$ROOT/toolchain}"
    BUILD="${OPENWAVE_LLVM_BUILD:-$ROOT/out/llvm-build}"
    configure=(-S "$ROOT/llvm-project/llvm" -B "$BUILD" -G Ninja
               -DCMAKE_INSTALL_PREFIX="$SDK")
    if [[ ! -f "$BUILD/CMakeCache.txt" ]]; then
        configure+=(-DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_PROJECTS='clang;lld'
                    -DLLVM_TARGETS_TO_BUILD="${OPENWAVE_LLVM_TARGETS:-X86}"
                    -DLLVM_PARALLEL_LINK_JOBS=1
                    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_BUILD_TESTS=OFF
                    -DCMAKE_C_COMPILER="${OPENWAVE_HOST_CC:-/usr/bin/cc}"
                    -DCMAKE_CXX_COMPILER="${OPENWAVE_HOST_CXX:-/usr/bin/c++}")
    fi
    native=(env -u CC -u CXX -u AR -u AS -u LD -u NM -u RANLIB -u STRIP
            -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS -u CPATH
            -u C_INCLUDE_PATH -u CPLUS_INCLUDE_PATH
            -u CMAKE_TOOLCHAIN_FILE -u CMAKE_PREFIX_PATH -u PKG_CONFIG_PATH
            -u PKG_CONFIG_SYSROOT_DIR -u PKG_CONFIG_LIBDIR -u LLVM)
    "${native[@]}" cmake "${configure[@]}"
    "${native[@]}" cmake --build "$BUILD" --parallel "${OPENWAVE_BUILD_JOBS:-4}"
    "${native[@]}" cmake --install "$BUILD"
)

build_all() (
    if (($#)); then
        echo "Usage: ./build-openwave all" >&2
        exit 2
    fi
    build_llvm
    build_sysroot
    source "$ROOT/env.sh" --build
    build_browser_engine deps
    OPENWAVE_BUILD_ALL=1 build_audio
    build_bluetooth_audio
    build_mdns
    build_selinux
    build_bubblewrap
    build_browser_engine engine
    build_userspace "$@"
)

build_sysroot() (
    "$ROOT/scripts/bootstrap-sysroot.sh"
)

build_graphics() (
    "$ROOT/scripts/build-mesa.sh"
)

build_cross_files() (
    source "$ROOT/env.sh" --bootstrap
    python3 "$ROOT/cross/generate-meson.py" --target "$OPENWAVE_TARGET_TRIPLE"
)

build_kernel() (
    source "$ROOT/env.sh" --build
    prepare_llvm
    local build="${OPENWAVE_KERNEL_BUILD:-$ROOT/out/linux}"
    local arch image
    case "$OPENWAVE_TARGET_TRIPLE" in
        x86_64-*) arch=x86; image=bzImage ;;
        aarch64-*) arch=arm64; image=Image ;;
        *) echo "Unsupported kernel target: $OPENWAVE_TARGET_TRIPLE" >&2; exit 1 ;;
    esac
    [[ -f "$build/.config" ]] || { echo "Configure $build/.config first" >&2; exit 1; }
    "$ROOT/linux/scripts/config" --file "$build/.config" -e SECURITY -e SECURITY_LANDLOCK \
        -e SECURITY_SELINUX -e SECURITY_SELINUX_DEVELOP -e EXT4_FS_SECURITY -e AUDIT \
        -e NET -e UNIX -e UNIX_DIAG -e SYSVIPC -e IPC_NS -e POSIX_MQUEUE \
        -e RTC_CLASS -e RTC_DRV_CMOS \
        -e CRYPTO -e CRYPTO_USER_API_HASH -e CRYPTO_USER_API_SKCIPHER -e CRYPTO_USER_API_AEAD \
        -e CRYPTO_AES -e CRYPTO_CBC -e CRYPTO_ECB -e CRYPTO_CMAC -e CRYPTO_HMAC \
        -e CRYPTO_SHA1 -e CRYPTO_SHA256 -e CRYPTO_SHA512 -e CRYPTO_MD4 -e CRYPTO_MD5 -e CRYPTO_DES \
        -e KEYS -e KEY_DH_OPERATIONS \
        -e WIRELESS -e CFG80211 -e MAC80211 -e RFKILL \
        -e NETDEVICES -e WLAN -e WLAN_VENDOR_RALINK -e RT2X00 -e RT2800USB \
        -e RT2800USB_RT33XX -e RT2800USB_RT35XX -e RT2800USB_RT53XX \
        -e USB -e USB_XHCI_HCD -e PACKET -e CRYPTO_CCM -e CRYPTO_GCM -e CRYPTO_CTR \
        -e INPUT -e INPUT_EVDEV -e VIRTIO -e VIRTIO_INPUT -e VIRTIO_NET \
        --set-str EXTRA_FIRMWARE_DIR "$OPENWAVE_SYSROOT/lib/firmware"
    local lsm
    lsm="$("$ROOT/linux/scripts/config" --file "$build/.config" --state LSM)"
    lsm="${lsm#\"}"; lsm="${lsm%\"}"
    if [[ "$lsm" == undef || "$lsm" == n ]]; then lsm=landlock; fi
    case ",$lsm," in
        *,selinux,*) ;;
        *) "$ROOT/linux/scripts/config" --file "$build/.config" --set-str LSM "${lsm:+$lsm,}selinux" ;;
    esac
    PATH="$OPENWAVE_SDK/bin:$PATH" make -C "$ROOT/linux" O="$build" ARCH="$arch" LLVM=1 olddefconfig
    # Fail here if Kconfig dependencies silently discarded a boot/sandbox
    # prerequisite; never publish a kernel which cannot create local IPC.
    for required in UNIX SYSVIPC IPC_NS USER_NS PID_NS NET_NS CGROUPS SECCOMP_FILTER SECURITY_SELINUX SECURITY_LANDLOCK CFG80211 MAC80211 RFKILL RT2800USB INPUT_EVDEV VIRTIO_INPUT VIRTIO_NET; do
        grep -qx "CONFIG_${required}=y" "$build/.config" || {
            echo "Missing required kernel feature: CONFIG_${required}=y" >&2
            exit 1
        }
    done
    PATH="$OPENWAVE_SDK/bin:$PATH" make -C "$ROOT/linux" O="$build" ARCH="$arch" LLVM=1 -j "${OPENWAVE_BUILD_JOBS:-4}" "$image"
)

build_audio() (

source "$ROOT/env.sh" --build
prepare_llvm
TARGET="$OPENWAVE_SYSROOT"
# GStreamer GL requires target Mesa EGL/GLES2 development files.
# Graphics is a separate stage and is never satisfied by host libraries.
if [[ "${1:-all}" != engine ]]; then
    "$ROOT/scripts/build-mesa.sh"
fi
JOBS="${OPENWAVE_BUILD_JOBS:-4}"
mkdir -p "$ROOT/out" "$ROOT/third_party"

fetch_tag() {
    local directory="$1" repository="$2" tag="$3" commit="$4"
    if [[ ! -d "$ROOT/third_party/$directory/.git" ]]; then
        git clone --depth 1 --branch "$tag" "$repository" \
            "$ROOT/third_party/$directory"
    fi
    if [[ "$(git -C "$ROOT/third_party/$directory" rev-parse HEAD)" != "$commit" ]]; then
        echo "Unexpected source revision for $directory" >&2
        exit 1
    fi
}

fetch_tag alsa-lib https://github.com/alsa-project/alsa-lib.git v1.2.16 \
    08b532cd3da9ac8f683bcb4e4beb9b74c39c1782
fetch_tag pipewire https://gitlab.freedesktop.org/pipewire/pipewire.git 1.4.9 \
    fd60e04525f3a04d90bf50085222e0cc9139b4a4
fetch_tag wireplumber https://gitlab.freedesktop.org/pipewire/wireplumber.git 0.5.18 \
    81606cbb32d29df20147d1b68b662c1082654d81

PATCH="$ROOT/userspace/audio-patches/pipewire-1.4.9-clang-const.patch"
if ! git -C "$ROOT/third_party/pipewire" apply --reverse --check "$PATCH" 2>/dev/null; then
    git -C "$ROOT/third_party/pipewire" apply --check "$PATCH"
    git -C "$ROOT/third_party/pipewire" apply "$PATCH"
fi

AUDIO_ACCESS_PATCH="$ROOT/userspace/audio-patches/pipewire-1.4.9-openwave-app-access.patch"
if ! git -C "$ROOT/third_party/pipewire" apply --reverse --check "$AUDIO_ACCESS_PATCH" 2>/dev/null; then
    git -C "$ROOT/third_party/pipewire" apply --check "$AUDIO_ACCESS_PATCH"
    git -C "$ROOT/third_party/pipewire" apply "$AUDIO_ACCESS_PATCH"
fi

if [[ -x "$ROOT/out/host-tools/bin/gdbus-codegen" ]]; then
    export PATH="$ROOT/out/host-tools/bin:$PATH"
fi

export PKG_CONFIG_LIBDIR="$TARGET/usr/lib64/pkgconfig:$TARGET/usr/share/pkgconfig"
export PKG_CONFIG_SYSROOT_DIR="$TARGET"
export CC="$OPENWAVE_SDK/bin/clang --target=$OPENWAVE_TARGET_TRIPLE --sysroot=$TARGET"
export AR="$OPENWAVE_SDK/bin/llvm-ar"
export RANLIB="$OPENWAVE_SDK/bin/llvm-ranlib"
export STRIP="$OPENWAVE_SDK/bin/llvm-strip"

if [[ ! -x "$ROOT/third_party/alsa-lib/configure" ]]; then
    (cd "$ROOT/third_party/alsa-lib" && \
        PATH="$ROOT/out/host-autotools/bin:$PATH" autoreconf -fi)
fi
mkdir -p "$OPENWAVE_DEPENDENCY_BUILD/alsa-lib"
(
    cd "$OPENWAVE_DEPENDENCY_BUILD/alsa-lib"
    "$ROOT/third_party/alsa-lib/configure" \
        --host="$OPENWAVE_AUTOTOOLS_HOST" --build=x86_64-pc-linux-gnu \
        --prefix=/usr --libdir=/usr/lib64 --disable-static --enable-shared \
        --with-configdir=/usr/share/alsa
    make -j "$JOBS"
    make DESTDIR="$TARGET" install
)

meson_setup() {
    local build="$1" source="$2"
    shift 2
    if [[ -f "$build/build.ninja" ]]; then
        meson setup --reconfigure "$build" "$source" "$@"
    else
        meson setup "$build" "$source" \
            --cross-file "$OPENWAVE_MESON_TOOLCHAIN" \
            --prefix=/usr --libdir=lib64 "$@"
    fi
}

meson_setup "$OPENWAVE_DEPENDENCY_BUILD/pipewire" "$ROOT/third_party/pipewire" \
    -Ddocs=disabled -Dman=disabled -Dexamples=disabled -Dtests=disabled \
    -Dinstalled_tests=disabled -Dgstreamer=disabled -Dsystemd=disabled \
    -Dlogind=disabled -Dspa-plugins=enabled -Dalsa=enabled -Ddbus=enabled \
    -Dudev=enabled -Dpipewire-alsa=enabled \
    -Dpipewire-jack=disabled -Djack=disabled -Dlibpulse=disabled \
    -Dlibcamera=disabled -Dv4l2=disabled -Dgsettings=disabled \
    -Dreadline=disabled -Dpw-cat=disabled -Dsession-managers=[]
ninja -C "$OPENWAVE_DEPENDENCY_BUILD/pipewire" -j "$JOBS"
DESTDIR="$TARGET" ninja -C "$OPENWAVE_DEPENDENCY_BUILD/pipewire" install

meson_setup "$OPENWAVE_DEPENDENCY_BUILD/wireplumber" "$ROOT/third_party/wireplumber" \
    -Dintrospection=disabled -Ddoc=disabled -Dtests=false \
    -Ddbus-tests=false -Dsystem-lua=false -Dsystemd=disabled \
    -Delogind=disabled -Dmodules=true -Ddaemon=true -Dtools=true
ninja -C "$OPENWAVE_DEPENDENCY_BUILD/wireplumber" -j "$JOBS"
DESTDIR="$TARGET" ninja -C "$OPENWAVE_DEPENDENCY_BUILD/wireplumber" install

# User applications are built by the explicit userspace target.

"$ROOT/linux/scripts/config" --file "$ROOT/out/linux/.config" -e SND_VIRTIO -e SECURITY -e SECURITY_LANDLOCK --set-str EXTRA_FIRMWARE_DIR "$TARGET/lib/firmware"
PATH="$OPENWAVE_SDK/bin:$PATH" make -C "$ROOT/linux" \
    O="$ROOT/out/linux" ARCH=x86 LLVM=1 olddefconfig
PATH="$OPENWAVE_SDK/bin:$PATH" make -C "$ROOT/linux" \
    O="$ROOT/out/linux" ARCH=x86 LLVM=1 -j "$JOBS" bzImage

echo "Audio stack installed into $TARGET; pack OpenWave.img separately."

)

build_bluetooth_audio() (

source "$ROOT/env.sh" --build
prepare_llvm
TOOLCHAIN="$OPENWAVE_SDK/bin"
SYSROOT="$OPENWAVE_SYSROOT"
SBC_SOURCE="$ROOT/third_party/sbc-2.2"
BLUEZ_SOURCE="$ROOT/third_party/bluez"
PIPEWIRE_SOURCE="$ROOT/third_party/pipewire"

for source in "$SBC_SOURCE/configure" "$BLUEZ_SOURCE/configure" "$PIPEWIRE_SOURCE/meson.build"; do
    if [[ ! -f "$source" ]]; then
        echo "Missing source: $source" >&2
        exit 1
    fi
done

for patch in \
    "$ROOT/userspace/audio-patches/pipewire-1.4.9-clang-const.patch" \
    "$ROOT/userspace/audio-patches/pipewire-1.4.9-bluez5-clang-const.patch" \
    "$ROOT/userspace/audio-patches/pipewire-1.4.9-bluez5-release.patch" \
    "$ROOT/userspace/audio-patches/pipewire-1.4.9-openwave-app-access.patch"; do
    if ! git -C "$PIPEWIRE_SOURCE" apply --reverse --check "$patch" 2>/dev/null; then
        git -C "$PIPEWIRE_SOURCE" apply --check "$patch"
        git -C "$PIPEWIRE_SOURCE" apply "$patch"
    fi
done

export CC="$TOOLCHAIN/clang --target=$OPENWAVE_TARGET_TRIPLE --sysroot=$SYSROOT"
export AR="$TOOLCHAIN/llvm-ar"
export RANLIB="$TOOLCHAIN/llvm-ranlib"
export STRIP="$TOOLCHAIN/llvm-strip"
export PKG_CONFIG_PATH=""
export PKG_CONFIG_SYSROOT_DIR="$SYSROOT"
export PKG_CONFIG_LIBDIR="$SYSROOT/usr/lib64/pkgconfig:$SYSROOT/usr/share/pkgconfig"

mkdir -p "$OPENWAVE_DEPENDENCY_BUILD/sbc-openwave" "$OPENWAVE_DEPENDENCY_BUILD/bluez-openwave"
(
    cd "$OPENWAVE_DEPENDENCY_BUILD/sbc-openwave"
    "$SBC_SOURCE/configure" --host="$OPENWAVE_AUTOTOOLS_HOST" \
        --build=x86_64-pc-linux-gnu --prefix=/usr --libdir=/usr/lib64 \
        --disable-tools --disable-tester --disable-static
    make -j "${OPENWAVE_BUILD_JOBS:-4}"
    make DESTDIR="$SYSROOT" install
)
(
    cd "$OPENWAVE_DEPENDENCY_BUILD/bluez-openwave"
    "$BLUEZ_SOURCE/configure" --host="$OPENWAVE_AUTOTOOLS_HOST" \
        --build=x86_64-pc-linux-gnu --prefix=/usr --libdir=/usr/lib64 \
        --sysconfdir=/etc --localstatedir=/var --disable-cups --disable-midi \
        --disable-obex --disable-client --disable-tools --disable-monitor \
        --disable-systemd --disable-manpages --enable-external-ell \
        --enable-library --with-dbusconfdir=/usr/share \
        --with-dbussystembusdir=/usr/share/dbus-1/system-services \
        --with-dbussessionbusdir=/usr/share/dbus-1/services \
        --with-udevdir=/usr/lib64/udev
    make -j "${OPENWAVE_BUILD_JOBS:-4}"
    make DESTDIR="$SYSROOT" install
)

if [[ -x "$ROOT/out/host-tools/bin/gdbus-codegen" ]]; then
    export PATH="$ROOT/out/host-tools/bin:$PATH"
fi

pipewire_options=(
    -Dbluez5=enabled -Dlibusb=disabled
    -Dbluez5-backend-hfp-native=disabled -Dbluez5-backend-hsp-native=disabled
    -Dbluez5-backend-ofono=disabled -Dbluez5-backend-hsphfpd=disabled
    -Dbluez5-codec-aac=disabled -Dbluez5-codec-aptx=disabled
    -Dbluez5-codec-ldac=disabled -Dbluez5-codec-lc3=disabled
    -Dbluez5-codec-lc3plus=disabled -Dbluez5-codec-opus=disabled
    -Dbluez5-codec-g722=disabled
)
if [[ -f "$OPENWAVE_DEPENDENCY_BUILD/pipewire/build.ninja" ]]; then
    meson configure "$OPENWAVE_DEPENDENCY_BUILD/pipewire" "${pipewire_options[@]}"
else
    meson setup "$OPENWAVE_DEPENDENCY_BUILD/pipewire" "$PIPEWIRE_SOURCE" \
        --cross-file="$OPENWAVE_MESON_TOOLCHAIN" \
        --prefix=/usr --libdir=lib64 \
        -Ddocs=disabled -Dman=disabled -Dexamples=disabled -Dtests=disabled \
        -Dinstalled_tests=disabled -Dgstreamer=disabled -Dsystemd=disabled \
        -Dlogind=disabled -Dspa-plugins=enabled -Dalsa=enabled -Ddbus=enabled \
        -Dudev=enabled -Dpipewire-alsa=enabled -Dpipewire-jack=disabled \
        -Djack=disabled -Dlibpulse=disabled -Dlibcamera=disabled \
        -Dv4l2=disabled -Dgsettings=disabled -Dreadline=disabled \
        -Dpw-cat=disabled '-Dsession-managers=[]' "${pipewire_options[@]}"
fi

if ! command -v gdbus-codegen >/dev/null 2>&1; then
    echo "The host gdbus-codegen build tool is required" >&2
    exit 1
fi
meson compile -C "$OPENWAVE_DEPENDENCY_BUILD/pipewire" -j "${OPENWAVE_BUILD_JOBS:-4}"
DESTDIR="$SYSROOT" meson install -C "$OPENWAVE_DEPENDENCY_BUILD/pipewire"
install -m644 "$ROOT/userspace/config/10-openwave-wireplumber.conf" \
    "$SYSROOT/etc/wireplumber/wireplumber.conf.d/10-openwave-wireplumber.conf"
echo "Installed target BlueZ library, SBC, PipeWire BlueZ SPA and WirePlumber configuration."

)

build_browser_engine() (
# Cross-build browser codecs and WPE; never writes an active disk image.
source "$ROOT/env.sh" --build
prepare_llvm
TARGET="$OPENWAVE_SYSROOT"
JOBS="${OPENWAVE_BUILD_JOBS:-3}"
case "${1:-all}" in
    all|deps|media|engine) ;;
    *) echo "Usage: $0 browser-engine [all|deps|media|engine]" >&2; exit 2 ;;
esac
export PKG_CONFIG_LIBDIR="$TARGET/usr/lib64/pkgconfig:$TARGET/usr/share/pkgconfig"
export PKG_CONFIG_SYSROOT_DIR="$TARGET"
export PATH="$ROOT/out/browser-build-tools:$ROOT/out/host-nasm/bin:$PATH"

# OpenWave uses glibc's x86_64 TLS stack guard. Older local LLVM builds
# treated the new OS triple as needing a nonexistent global guard instead.
mkdir -p "$ROOT/out"
"$OPENWAVE_SDK/bin/clang" --target=$OPENWAVE_TARGET_TRIPLE --sysroot="$TARGET" \
    -fstack-protector-strong -x c -S -o "$ROOT/out/browser-stack-guard.s" - <<'C'
extern void use_buffer(char *);
void check_guard(void) { char buffer[32]; use_buffer(buffer); }
C
if [[ ${OPENWAVE_TARGET_TRIPLE%%-*} == x86_64 ]] && ! rg -q '%fs:40' "$ROOT/out/browser-stack-guard.s"; then
    echo "Rebuild LLVM with OpenWave TLS stack-guard support before building media libraries." >&2
    exit 1
fi

fetch_tag() {
    local name="$1" url="$2" tag="$3" commit="$4"
    if [[ ! -d "$ROOT/third_party/$name/.git" ]]; then
        git clone --depth 1 --branch "$tag" "$url" "$ROOT/third_party/$name"
    fi
    test "$(git -C "$ROOT/third_party/$name" rev-parse HEAD)" = "$commit"
}
fetch_tar() {
    local name="$1" url="$2" sha="$3" archive="$ROOT/third_party/$1.tar.xz"
    if [[ ! -f "$archive" ]]; then curl --fail --location "$url" -o "$archive"; fi
    echo "$sha  $archive" | sha256sum --check
    if [[ ! -d "$ROOT/third_party/$name" ]]; then tar -xf "$archive" -C "$ROOT/third_party"; fi
}
meson_setup() {
    local name="$1" source="$2"
    shift 2
    local reconfigure=()
    if [[ -f "$OPENWAVE_DEPENDENCY_BUILD/$name/build.ninja" ]]; then reconfigure=(--reconfigure); fi
    meson setup "${reconfigure[@]}" "$OPENWAVE_DEPENDENCY_BUILD/$name" "$source" \
        --cross-file "$OPENWAVE_MESON_TOOLCHAIN" --prefix=/usr \
        --libdir=lib64 --buildtype=release "$@"
}

if [[ "${1:-all}" != engine ]]; then
    mkdir -p "$ROOT/third_party" "$ROOT/out"
    if [[ "${1:-all}" != media ]]; then
    fetch_tar nasm-3.02 https://www.nasm.us/pub/nasm/releasebuilds/3.02/nasm-3.02.tar.xz \
        87336eba53b4acfe917424ab5d500d2b0054d9f5148d35c2273ccf2cfb712f0d
    # NASM runs on the build host and is never installed into the target sysroot.
    if [[ ! -x "$ROOT/out/host-nasm/bin/nasm" ]]; then
        (cd "$ROOT/third_party/nasm-3.02"; ./configure --prefix="$ROOT/out/host-nasm"; \
            make -j "$JOBS"; make install)
    fi
    fetch_tar dav1d-1.5.4 https://download.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz \
        686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5
    meson_setup dav1d-openwave "$ROOT/third_party/dav1d-1.5.4" \
        -Denable_tools=false -Denable_tests=false -Denable_docs=false
    ninja -C "$OPENWAVE_DEPENDENCY_BUILD/dav1d-openwave" -j "$JOBS"
    DESTDIR="$TARGET" meson install -C "$OPENWAVE_DEPENDENCY_BUILD/dav1d-openwave" --no-rebuild

    fetch_tag libavif https://github.com/AOMediaCodec/libavif.git v1.4.2 c5240fc79fe5c2407e10afd35f5505ef6333ea49
    openwave_cmake_configure -S "$ROOT/third_party/libavif" -B "$OPENWAVE_DEPENDENCY_BUILD/libavif-openwave" -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE="$OPENWAVE_CMAKE_TOOLCHAIN" \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DBUILD_SHARED_LIBS=ON -DAVIF_CODEC_DAV1D=SYSTEM -DAVIF_LIBYUV=OFF \
        -DAVIF_BUILD_APPS=OFF -DAVIF_BUILD_TESTS=OFF
    cmake --build "$OPENWAVE_DEPENDENCY_BUILD/libavif-openwave" --parallel "$JOBS"
    DESTDIR="$TARGET" cmake --install "$OPENWAVE_DEPENDENCY_BUILD/libavif-openwave"

    fetch_tag libvpx https://github.com/webmproject/libvpx.git v1.15.2 d168454ecd099805c675d4a98c66f4891373302a
    mkdir -p "$OPENWAVE_DEPENDENCY_BUILD/libvpx-openwave"
    (cd "$OPENWAVE_DEPENDENCY_BUILD/libvpx-openwave"
        CC="$OPENWAVE_SDK/bin/clang --target=$OPENWAVE_TARGET_TRIPLE --sysroot=$TARGET" \
        CXX="$OPENWAVE_SDK/bin/clang++ --target=$OPENWAVE_TARGET_TRIPLE --sysroot=$TARGET" \
        AR="$OPENWAVE_SDK/bin/llvm-ar" LD="$OPENWAVE_SDK/bin/clang --target=$OPENWAVE_TARGET_TRIPLE --sysroot=$TARGET" \
        STRIP="$OPENWAVE_SDK/bin/llvm-strip" \
        "$ROOT/third_party/libvpx/configure" --target=${OPENWAVE_TARGET_TRIPLE%%-*}-linux-gcc \
            --prefix=/usr --libdir=/usr/lib64 --enable-shared --disable-static \
            --disable-examples --disable-tools --disable-docs --disable-unit-tests
        make -j "$JOBS"
        make DESTDIR="$TARGET" install)

    fi

    fetch_tag gstreamer https://github.com/GStreamer/gstreamer.git 1.28.8 1b2a95a1b72787cda146b46df9605b168e5b683b
    # GLib's enum/marshal generators are Python scripts that run on the host.
