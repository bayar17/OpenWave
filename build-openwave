COMMAND="${1:-help}"
if (($#)); then shift; fi
if [[ "$COMMAND" == help || "$COMMAND" == --help || "$COMMAND" == -h || "${1:-}" == --help || "${1:-}" == -h ]]; then
    usage
    exit 0
fi
# Standalone OpenRC cross-build; never builds or assembles an image/rootfs.
if [[ "$COMMAND" == openrc ]]; then
    if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != --clean ]]; }; then
        usage >&2
        exit 2
    fi
    exec bash "$ROOT/userspace/openrc/build-openrc.sh" "$@"
fi

case "$COMMAND" in
    audio|bluetooth-audio|mdns|selinux|bubblewrap|sdk|tzdata|llvm-patch|llvm|kernel|sysroot|cross-files|graphics)
        if (($# != 0)); then usage >&2; exit 2; fi
        ;;
    browser-engine)
        if (($# > 1)); then usage >&2; exit 2; fi
        case "${1:-all}" in all|deps|media|engine) ;; *) usage >&2; exit 2 ;; esac
        ;;
    waydroid-host-deps|waydroid-bindings)
        if (($# != 0)); then usage >&2; exit 2; fi
        ;;
    userspace|all)
        if (($# != 0)); then usage >&2; exit 2; fi
        ;;
    rootfs)
        if (($# != 0)); then usage >&2; exit 2; fi
        ;;
    image)
        if (($# != 2)); then usage >&2; exit 2; fi
        ;;
    test-appd|test-browser-input|test-permissions|test-selinux)
        if (($# != 1)); then usage >&2; exit 2; fi
        ;;
    *) usage >&2; exit 2 ;;
esac
"build_${COMMAND//-/_}" "$@"
