build_selinux() (
source "$ROOT/env.sh" --build
prepare_llvm
local version=3.11 build="$OPENWAVE_DEPENDENCY_BUILD/selinux-3.11"
local package checksum archive cc ar ranlib cflags
mkdir -p "$build" "$ROOT/third_party"
export PKG_CONFIG_SYSROOT_DIR="$OPENWAVE_SYSROOT"
export PKG_CONFIG_LIBDIR="$OPENWAVE_SYSROOT/usr/lib64/pkgconfig:$OPENWAVE_SYSROOT/usr/lib/pkgconfig:$OPENWAVE_SYSROOT/usr/share/pkgconfig"
unset PKG_CONFIG_PATH CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH LIBRARY_PATH
pkg-config --exists libpcre2-8 || {
    echo 'SELinux requires target PCRE2 in the exported SDK.' >&2
    exit 1
}
command -v flex >/dev/null || { echo 'SELinux requires host flex.' >&2; exit 1; }
# Make recipes execute these commands through a shell; quote SDK paths there.
printf -v cc '%q --target=%q --sysroot=%q' "$OPENWAVE_SDK/bin/clang" "$OPENWAVE_TARGET_TRIPLE" "$OPENWAVE_SYSROOT"
printf -v ar '%q' "$OPENWAVE_SDK/bin/llvm-ar"
printf -v ranlib '%q' "$OPENWAVE_SDK/bin/llvm-ranlib"
cflags='-O2 -std=gnu17 -fPIC -fstack-protector-strong'
case "$OPENWAVE_TARGET_TRIPLE" in x86_64-*) cflags+=' -mstack-protector-guard=tls' ;; esac
local options=("CC=$cc" "AR=$ar" "RANLIB=$ranlib" "CFLAGS=$cflags"
               'CPPFLAGS=-I../../install/usr/include' 'LDFLAGS=-Wl,-z,relro,-z,now' OS=Linux
               "ARCH=${OPENWAVE_TARGET_TRIPLE%%-*}" PREFIX=/usr
               LIBDIR=/usr/lib64 SHLIBDIR=/usr/lib64)
for package in libsepol libselinux; do
    case "$package" in
        libsepol) checksum=79f3d2c88f44b7eb5cf54d9792e03232297e17f97a179163f2750099a00f164d ;;
        libselinux) checksum=73d419c6e20e874adaa4019372cbd097eecf4d276e13f27ec5e67d35c0bd203c ;;
    esac
    archive="$build/$package-$version.tar.gz"
    if [[ ! -f "$archive" ]]; then
        curl -L --fail --silent --show-error \
            "https://github.com/SELinuxProject/selinux/releases/download/$version/$package-$version.tar.gz" \
            -o "$archive.partial"
        printf '%s  %s\n' "$checksum" "$archive.partial" | sha256sum -c -
        mv "$archive.partial" "$archive"
    fi
    printf '%s  %s\n' "$checksum" "$archive" | sha256sum -c -
    if [[ ! -d "$ROOT/third_party/$package-$version" ]]; then
        tar -xf "$archive" -C "$ROOT/third_party"
    fi
    if [[ ! -d "$build/$package-$version" ]]; then
        cp -a "$ROOT/third_party/$package-$version" "$build/"
    fi
    # Build just the C libraries, retaining CIL support without language bindings
    # or policy utilities. Relative DESTDIR also works in paths containing spaces.
    make -C "$build/$package-$version/src" "${options[@]}" clean
    if [[ "$package" == libsepol ]]; then
        make -C "$build/$package-$version/src" "${options[@]}" -j "${OPENWAVE_BUILD_JOBS:-4}"
        make -C "$build/$package-$version/src" "${options[@]}" DESTDIR=../../install install
        make -C "$build/$package-$version/include" "${options[@]}" DESTDIR=../../install install
    else
        # Its version map includes optional 32-bit compatibility symbols. LLD
        # needs this upstream-supported flag when those aliases are not built.
        make -C "$build/$package-$version" "${options[@]}" EXTRA_LD_FLAGS=--undefined-version \
            SUBDIRS=src -j "${OPENWAVE_BUILD_JOBS:-4}"
        make -C "$build/$package-$version" "${options[@]}" EXTRA_LD_FLAGS=--undefined-version \
            SUBDIRS='src include' DESTDIR=../../install install
    fi
    install -Dm644 "$build/$package-$version/LICENSE" \
        "$build/install/usr/share/licenses/$package/LICENSE"
    if [[ "$package" == libsepol ]]; then
        sed -n '1,/^ \*\//p' "$build/$package-$version/cil/include/cil/cil.h" \
            > "$build/install/usr/share/licenses/$package/LICENSE.CIL"
    fi
done
cp -a "$build/install/usr/." "$OPENWAVE_SYSROOT/usr/"
python3 "$ROOT/scripts/build-openwave-selinux.py" --sdk "$OPENWAVE_SDK" \
    --target "$OPENWAVE_TARGET_TRIPLE" --stage "$OPENWAVE_RUNTIME_STAGE" \
    --output "$OPENWAVE_DEPENDENCY_BUILD/selinux-policy"
)

