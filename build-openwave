        -Dgst-plugins-bad:hls-crypto=openssl "${plugins[@]}"
    test "$(git -C "$ROOT/third_party/gstreamer/subprojects/FFmpeg" rev-parse HEAD)" = cde7209117ec2be9da087b9e5f96d48450fdecd2
    test "$(git -C "$ROOT/third_party/gstreamer/subprojects/orc" rev-parse HEAD)" = 141218e37a1da2ffa1f3f1c996092f61782f3235
    local_gudev="$ROOT/third_party/gstreamer/subprojects/libgudev-238"
    if [[ -d "$local_gudev" ]] && ! rg -q -- '-Wl,--export-dynamic' "$local_gudev/gudev/meson.build"; then
