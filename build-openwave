        -j"${OPENWAVE_BUILD_JOBS:-4}" ip
    install -Dm755 "$source/ip/ip" "$OPENWAVE_RUNTIME_STAGE/sbin/ip"
    install -d "$OPENWAVE_RUNTIME_STAGE/usr/share/iproute2"
    find "$source/etc/iproute2" -maxdepth 1 -type f -exec \
        install -m644 -t "$OPENWAVE_RUNTIME_STAGE/usr/share/iproute2" {} +
    if [[ ! -f "$iptables_archive" ]]; then
        curl -fL --retry 3 \
            "https://www.netfilter.org/pub/iptables/iptables-$iptables_version.tar.xz" \
            -o "$iptables_archive.partial"
        printf '%s  %s\n' "$iptables_checksum" "$iptables_archive.partial" | sha256sum -c -
        mv "$iptables_archive.partial" "$iptables_archive"
    fi
    printf '%s  %s\n' "$iptables_checksum" "$iptables_archive" | sha256sum -c -
    if [[ ! -d "$iptables_source" ]]; then
        mkdir -p "$iptables_source"
        tar -xf "$iptables_archive" --strip-components=1 -C "$iptables_source"
    fi
    if [[ ! -x "$iptables_source/configure" ]]; then
        (cd "$iptables_source" && ./autogen.sh)
    fi
    if [[ ! -f "$iptables_source/Makefile" ]]; then
        (cd "$iptables_source" && \
            CC="$cc" CFLAGS="--target=$OPENWAVE_TARGET_TRIPLE --sysroot=$OPENWAVE_SYSROOT -O2 -fPIC" \
            LDFLAGS="--target=$OPENWAVE_TARGET_TRIPLE --sysroot=$OPENWAVE_SYSROOT -L$OPENWAVE_SYSROOT/usr/lib64" \
            ./configure --host=x86_64-unknown-linux-gnu --prefix=/usr \
                --sbindir=/usr/sbin --libdir=/usr/lib64 \
                --disable-nftables --disable-devel --disable-bpf-compiler)
    fi
    make -C "$iptables_source" CC="$cc" \
        CFLAGS="--target=$OPENWAVE_TARGET_TRIPLE --sysroot=$OPENWAVE_SYSROOT -O2 -fPIC" \
        LDFLAGS="--target=$OPENWAVE_TARGET_TRIPLE --sysroot=$OPENWAVE_SYSROOT -L$OPENWAVE_SYSROOT/usr/lib64" \
        -j"${OPENWAVE_BUILD_JOBS:-4}"
    make -C "$iptables_source" DESTDIR="$OPENWAVE_RUNTIME_STAGE" install

    local commit=5b7e2e71be3f6bfaaaab3b461251dacaf1ce4991
    if [[ "$(git -C "$waydroid_source" rev-parse HEAD)" != "$commit" ]] \
        || [[ -n "$(git -C "$waydroid_source" status --porcelain)" ]]; then
        echo "Refusing to package Waydroid: source is not clean at $commit" >&2
        exit 1
    fi
    rm -rf "$package"
    mkdir -p "$package"
    git -C "$waydroid_source" archive "$commit" | tar -x -C "$package"
    make -C "$package" install DESTDIR="$OPENWAVE_RUNTIME_STAGE" \
        USE_SYSTEMD=0 USE_DBUS_ACTIVATION=0 USE_NFTABLES=0
    python3 "$ROOT/userspace/waydroid/prepare_apparmor_free.py" \
        --package "$OPENWAVE_RUNTIME_STAGE"
    python3 "$ROOT/userspace/waydroid/verify_upstream_package.py" \
        --source "$waydroid_source" --package "$OPENWAVE_RUNTIME_STAGE" \
        --no-dbus-activation \
        > "$build/upstream-integrity.json"
)

