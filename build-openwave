write "$OPENWAVE_SYSROOT/usr/lib/libQt6Test.so.6" /usr/lib/libQt6Test.so.6
rm /System/Applications/com.openwave.settings/manifest.json
write "$QA_OUTPUT/settings-manifest.json" /System/Applications/com.openwave.settings/manifest.json
sif /System/Applications/com.openwave.settings/manifest.json mode 0100644
write "$QA_OUTPUT/settings-icon.png" /System/Applications/com.openwave.settings/resources/icon.png
